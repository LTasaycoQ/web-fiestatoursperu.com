{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*":    ["src/layouts/*"],
      "@i18n":         ["src/i18n/index.ts"],
      "@i18n/*":       ["src/i18n/*"],
      "@lib/*":        ["src/lib/*"],
      "@styles/*":     ["src/styles/*"],
      "@assets/*":     ["src/assets/*"]
    }
  }
}
