
---
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations, localePath } from "@i18n/index";
import type { Locale } from "@i18n/index";
import { incentivosExperiences, incentivosFeatures, incentivosStats, incentivosCategories } from "src/data/incentivos";

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const i = t.incentivos;

const features = incentivosFeatures.map(feature => ({
  icon: feature.icon,
  title: i.featureTranslations[feature.titleKey] || "",
  desc: i.featureTranslations[feature.descKey] || "",
  badge: feature.badge
}));

const experiences = incentivosExperiences.map(exp => ({
  ...exp,
  tag: i.tagTranslations[exp.tagKey] || exp.tagKey,
  title: i.experienceTranslations[exp.titleKey] || "",
  desc: i.experienceTranslations[exp.descKey] || "",
  cta: i.experienceTranslations[exp.ctaKey] || "Descubrir"
}));

const stats = incentivosStats.map(stat => ({
  num: stat.num,
  label: i.statTranslations[stat.labelKey] || ""
}));

const icons: Record<string, string> = {
  medal: `<svg width="64px" height="64px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#b08c3a" stroke="#b08c3a" stroke-width="0.192"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g id="icomoon-ignore"> </g> <path d="M26.995 12.046h4.258l-15.457-9.152-15.049 9.152h3.857v15.994h-2.132v1.066h26.656v-1.066h-2.133v-15.994zM4.553 10.98l11.25-6.842 11.556 6.842h-22.807zM5.67 28.040v-15.994h3.199v15.994h-3.199zM9.935 28.040v-15.994h3.199v15.994h-3.199zM14.2 28.040v-15.994h3.199v15.994h-3.199zM18.465 28.040v-15.994h3.199v15.994h-3.199zM22.73 28.040v-15.994h3.199v15.994h-3.199z" fill="#b08c3a"> </path> </g></svg>`,
  compass: `<svg height="64px" width="64px" version="1.1" id="_x32_" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="-25.6 -25.6 563.20 563.20" xml:space="preserve" fill="#d89e51" stroke="#d89e51" stroke-width="13.824000000000002"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css"> .st0{fill:#ffffff;} </style> <g> <path class="st0" d="M203.364,2.333c-11.788,0-19.73,9.352-19.73,20.873v99.422c0,11.306-5.814,16.714-14.728,16.714 c-8.142,0-12.945-6.717-12.945-14.692L155.517,21.37C155.517,8.338,144.144,0,133.59,0c-10.558,0-21.926,8.338-21.926,21.37V124.65 c0,7.976-5.252,14.692-13.395,14.692c-8.903,0-14.721-5.408-14.721-16.714V23.206c0-11.521-7.943-20.873-19.731-20.873 c-11.797,0.02-18.08,10.173-19.359,20.131c-1.279,9.967-7.825,81.147-8.542,126.64c-0.727,45.504,31.216,72.117,49.414,80.571 c12.442,5.779,21.448,18.207,21.448,33.154L99.334,512h68.509l-7.444-249.171c0-14.946,9-27.374,21.443-33.154 c18.202-8.454,50.146-35.067,49.423-80.571c-0.722-45.493-7.258-116.673-8.547-126.64C221.434,12.506,215.157,2.353,203.364,2.333z "></path> <path class="st0" d="M378.422,3.935c-47.398,0-97.68,50.57-97.68,130.008c0,45.504,34.389,82.446,49.424,95.732 c14.702,13.004,21.448,18.207,21.448,33.154L344.17,512h68.509l-7.449-249.171c0-14.946,6.756-20.15,21.458-33.154 c15.014-13.287,49.408-50.228,49.408-95.732C476.097,54.505,425.82,3.935,378.422,3.935z"></path> </g> </g></svg>`,
  diamond: `<svg fill="#b08c3a" width="64px" height="64px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg" stroke="#b08c3a" stroke-width="0.00032"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M31.835 9.233l-4.371-8.358c-0.255-0.487-0.915-0.886-1.464-0.886h-10.060c-0.011-0.001-0.022-0.003-0.033-0.004-0.009 0-0.018 0.003-0.027 0.004h-9.88c-0.55 0-1.211 0.398-1.47 0.883l-4.359 8.197c-0.259 0.486-0.207 1.248 0.113 1.696l15.001 20.911c0.161 0.224 0.375 0.338 0.588 0.338 0.212 0 0.424-0.11 0.587-0.331l15.247-20.758c0.325-0.444 0.383-1.204 0.128-1.691zM29.449 8.988h-5.358l2.146-6.144zM17.979 1.99h6.436l-1.997 5.716zM20.882 8.988h-9.301l4.396-6.316zM9.809 8.034l-2.006-6.044h6.213zM21.273 10.988l-5.376 15.392-5.108-15.392h10.484zM13.654 25.971l-10.748-14.983h5.776zM23.392 10.988h5.787l-11.030 15.018zM5.89 2.575l2.128 6.413h-5.539z"></path> </g></svg>`,
  leaf: `<svg version="1.0" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 64 64" enable-background="new 0 0 64 64" xml:space="preserve" fill="#b08c3a" stroke="#b08c3a" stroke-width="0.00064"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path fill="#b08c3a" d="M34.929,7.629c-0.205-0.513-0.787-0.763-1.297-0.557c-0.513,0.203-0.764,0.784-0.562,1.297 c0.019,0.047,1.84,4.804-0.032,11.356c0,0-0.001,0.007-0.001,0.011c-1.215,1.103-2.459,2.271-3.744,3.557 c-1.357,1.357-2.591,2.671-3.745,3.948c0.998-9.183-0.498-16.128-0.571-16.458c-0.12-0.539-0.654-0.876-1.193-0.76 c-0.539,0.12-0.879,0.654-0.76,1.193c0.019,0.086,1.823,8.469,0.13,18.763c-2.26,2.695-4.05,5.14-5.464,7.261 c0.709-7.9-0.644-14.145-0.713-14.457c-0.12-0.539-0.65-0.886-1.193-0.759c-0.539,0.119-0.879,0.653-0.76,1.192 c0.02,0.087,1.885,8.75,0.048,18.297c-1.383,2.488-1.953,3.988-2.01,4.141c-0.19,0.518,0.074,1.092,0.592,1.283 C13.768,46.979,13.885,47,14,47c0.406,0,0.788-0.25,0.938-0.653c0.013-0.034,0.5-1.302,1.684-3.468 c10.438-2.726,19.995,0.051,20.092,0.079C36.809,42.986,36.905,43,37,43c0.431,0,0.828-0.28,0.958-0.714 c0.158-0.528-0.142-1.085-0.671-1.244C36.897,40.924,28.2,38.391,18,40.506c1.416-2.316,3.406-5.218,6.108-8.52 c0.052-0.006,0.104-0.008,0.154-0.021c10.595-2.889,21.367-0.029,21.475,0C45.825,31.988,45.913,32,46,32 c0.44,0,0.844-0.292,0.965-0.737c0.145-0.533-0.169-1.082-0.702-1.228c-0.425-0.116-9.801-2.598-20.012-0.576 c1.341-1.524,2.814-3.109,4.456-4.752c1.41-1.41,2.777-2.693,4.103-3.88c6.452-1.649,12.852,0.116,12.916,0.135 C47.817,20.987,47.909,21,48,21c0.436,0,0.836-0.287,0.961-0.727c0.151-0.53-0.155-1.083-0.687-1.235 c-0.239-0.067-4.9-1.367-10.473-0.779c8.531-7.021,14.472-9.294,14.545-9.321c0.518-0.191,0.782-0.767,0.591-1.284 c-0.191-0.519-0.766-0.779-1.283-0.592c-0.326,0.12-6.805,2.58-16.068,10.431C36.527,11.7