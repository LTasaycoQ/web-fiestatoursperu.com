  rails: '<svg height="64px" width="64px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 496.03 496.03" xml:space="preserve" fill="#b08c3a" stroke="#b08c3a"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <path style="fill:#b08c3a;" d="M101.823,373.841h2.3l33.043-0.008l224.788-0.049l33.002-0.008h0.48 c0.829,0,1.821-0.602,2.91-1.626c6.527-6.178,17.005-29.807,23.508-58.363l-0.683-148.192c-0.033-7.186-1.049-19.216-2.227-26.272 L395.614,6.974C394.988,3.219,391.192,0,387.469,0H109.317c-3.682,0-7.592,3.3-8.21,6.934l-24.126,132.52 c-1.195,6.974-2.211,18.972-2.211,26.109v149.712c7.47,25.881,18.192,50.202,24.768,56.876 C100.368,372.988,101.14,373.597,101.823,373.841z M402.23,250.474c8.649,13.12,5.023,30.767-8.104,39.415l-20.882,13.754v7.6 c0,15.713-12.737,28.45-28.45,28.45s-28.45-12.737-28.45-28.45v-38.237l46.479-30.637 C375.951,233.729,393.598,237.363,402.23,250.474z M107.114,165.538c0-5.958,0.813-15.55,1.821-21.419l18.736-101.144 c1.008-5.869,6.649-10.632,12.607-10.632h216.188c5.958,0,11.583,4.763,12.559,10.64l18.143,101.128 c0.975,5.877,1.788,15.477,1.821,21.427l0.602,47.129c-143.299,49.511-282.468,0-282.468,0v-47.129H107.114z M92.02,250.474 c8.641-13.111,26.288-16.753,39.415-8.104l46.479,30.628v38.245c0,15.713-12.737,28.45-28.45,28.45s-28.45-12.737-28.45-28.45 v-7.592l-20.89-13.762C87.004,281.241,83.379,263.593,92.02,250.474z"></path> <circle style="fill:#b08c3a;" cx="149.976" cy="305.984" r="17.298"></circle> <circle style="fill:#b08c3a;" cx="122.217" cy="271.283" r="17.298"></circle> <circle style="fill:#b08c3a;" cx="372.057" cy="271.283" r="17.298"></circle> <circle style="fill:#b08c3a;" cx="344.298" cy="305.984" r="17.298"></circle> <path style="fill:#b08c3a;" d="M81.526,493.063h31.604l5.731-28.45h261.285l6.3,31.417h30.49l-5.649-31.417h18.102l-8.129-35.563 h-16.363l-3.837-21.337h15.883l-5.592-26.166c-4.064,4.503-8.592,7.405-13.534,8.161c-0.797,0.122-1.569,0.325-2.39,0.325h-30.222 H133.89h-32.547c-0.098,0-0.187-0.041-0.285-0.041c-6.08-0.138-11.778-4.682-16.981-11.665l-6.283,29.385h19.899l-4.04,21.337 H74.771l-8.129,35.563h20.273L81.526,493.063z M130.329,407.713h238.411l4.276,21.337H126.029L130.329,407.713z"></path> </g> </g> </g></svg>',
};
---

<BaseLayout fullscreen={true} title={i.metaTitle} description={i.metaDesc}>

  <section class="inc-hero">
    <div class="inc-hero__bg">
      <img
        src="https://res.cloudinary.com/dlgeap8h0/image/upload/v1778686533/iStock-2170572054_asyynl.jpg" style="  transform: scaleX(-1);"
        alt="" aria-hidden="true" fetchpriority="high"
      />
    </div>
    <div class="inc-hero__overlay"></div>
    <div class="inc-hero__content" data-aos="fade-up">
      <div style="display: flex; align-items: center; gap: 10px;">
        <p class="eyebrow-light" style="margin-bottom: 0px; color: #d89e51; font-family: var(--font-ppnue);">Destinos</p>
        <span style="width: 50px; height: 1px; background-color: #d89e51; margin: 0px;" />
      </div>
      <h1 class="inc-hero__title">
        Perú; un país
        <br>
        <em style="color: #AF8A44; font-style: normal;">de grandes historias</em>
      </h1>
      <p class="inc-hero__sub" style="font-size: 17px;">
        Desde la costa del Pacifico hasta los Andes y la Amazonia,
        conocemos el Perú <br> en profundidad y diseñamos experiencias que combinan
        cultura, naturaleza, gastronomía y momentos <br> extraordinarios.
      </p>
      <a href={localePath(lang, '/contacto')} class="btn-primary" style=" font-family: var(--font-ppnue);">
          EXPLORA NUESTROS DESTINOS
      </a>
    </div>
  </section>

  <section class="inc-exp content-section" style="background:#fff">
   

    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 30px; margin-bottom: 36px; max-width: 1500px; margin-left: auto; margin-right: auto;">
     
      <div>
         <div style="display: flex; align-items: center; gap: 20px; max-width: 1400px; margin: 0 auto;">
          <p data-aos="fade-right" class="eyebrow" style="margin-bottom: 0px; color:rgb(201, 163, 92); font-family: var(--font-ppnue); font-size: 14px;">NUESTROS DESTINOS</p>
          <span class="verde-rule"></span>
        </div>

        <h2 data-aos="fade-right" class="display-title" style="font-size: 40px; font-weight: 500; color::var(--color-darker); margin: 0;">
          Lugares extraordinarios, <br>
          <em style="color: rgb(201, 163, 92); font-style: normal;">experiencias únicas</em>
        </h2>
      </div>
      
      <p style="width: 42%; min-width: 280px; font-family: var(--font-ppnue);font-size: 18px; color: rgb(62, 62, 62); font-size: 15px; line-height: 1.65; margin: 0;">
        Cada destino en el Perú ofrece un mundo de posibilidades. Combinamos nuestro profundo conocimiento del territorio con una red de aliados de primer nivel para crear experiencias auténticas y memorables para sus clientes.
      </p>
    </div>

    <div class="inc-exp__grid" data-aos="fade-up">
      {experiences.map((e, idx) => (
        <article class="exp-card">
          <div class="exp-card__img-wrap">
            <img src={e.img} alt={e.title} loading="lazy" width="600" height="400" />
            <div class="exp-card__img-overlay"></div>

            <div class="exp-card__content">
              <div class="exp-card__header">
                <h4 class="exp-card__title" style="font-size: 18px;">{e.title}</h4>
              </div>
              <p class="exp-card__desc"  style="font-size: 15px;">{e.desc}</p>
              {/* <a href={localePath(lang, '/contacto')} class="exp-card__cta">
                {e.cta} <span>&rarr;</span>
              </a> */}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="inc-cats content-section">
   

    <div style="font-family: var(--font-ppnue);display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 30px; margin-bottom: 32px; max-width: 1500px; margin-left: auto; margin-right: auto;">
    
      <div>
         <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 20px; max-width: 1500px; margin-left: auto; margin-right: auto;">
            <p data-aos="fade-right" class="eyebrow" style="margin: 0; color: #b08c3a; letter-spacing: 0.25em;font-size: 14px;">
              EXPERIENCIAS
            </p>
            <span class="verde-rule" style="margin: 0; width: 40px; background: #d9c9a3;"></span>
          </div>

            <h2 data-aos="fade-right" class="display-title" style="font-family: var(--font-ppnue); max-width: 520px;font-size: 40px; font-weight: 500; ">
          Más que destinos, <br>
          <em style="font-style: normal;font-family: var(--font-ppnue);">experiencias que conectan el Perú</em>
        </h2>
      </div>
      
      <p style="width: 40%; min-width: 280px; font-family: var(--font-ppnue); color: #3a3a3a; font-size: 18px; line-height: 1.65; margin: 0; padding-top: 16px;">
        Diseñamos programas que combinan lo mejor de nuestros destinos para crear experiencias únicas, adaptadas a los intereses de sus clientes.
      </p>
    </div>

    <div class="inc-cats__grid" data-aos="fade-up">
      {incentivosCategories.map((cat) => (
        <article class="cat-card" style="margin: 10px;">
          <div class="cat-card__img">
            <img src={cat.img} alt="logo_image" loading="lazy" />
          </div>
          <div class="cat-card__body">
            <div class="cat-card__icon" set:html={icons[cat.icon] || icons.medal} />
            <h4 class="cat-card__title" style="font-family: var(--font-ppnue); font-size: 17px;">{i.categoryTranslations[cat.titleKey] || ""}</h4>
            <p class="cat-card__desc" style="font-family: var(--font-ppnue); font-size: 15px;">{i.categoryTranslations[cat.descKey] || ""}</p>
            {/* <a href={localePath(lang, '/contacto')} class="cat-card__cta">
              {i.categoryCta || "Conocer más"} <span>&rarr;</span>
            </a> */}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="inc-cta">
    <div class="inc-cta__bg" style="background-image:linear-gradient(rgba(0, 0, 0, 0.634)), url(https://res.cloudinary.com/dlgeap8h0/image/upload/v1789594184/cusco-3544704_ksafcb.jpg); background-size: cover; background-repeat: no-repeat; " aria-hidden="true"></div>

    <div class="inc-cta__inner" style="display:flex; justify-content: space-between; align-items: center; max-width: 1700px;" data-aos="fade-up">
      <div style="display: flex; flex-direction: column; text-align: start;">
        <h2 class="inc-cta__title" style="font-family: var(--font-ppnue); font-weight: 500;">¿Listo para diseñar el viaje perfecto</h2>
        <span style="font-size: 17px; font-family: var(--font-ppnue); ">Nuestro equipo esta listo para crear el programa ideal para sus clientes</span>
      </div>
      <div class="cta-actions">
        <a href={localePath(lang, '/contacto')} class="btn-primary">Contactanos</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Variables ── */
:root {
  --verde: var(--color-verde, #3e4b3c);
  --verdec: var(--color-verdec, #478a3d);
  --darker: var(--color-darker, #0e0b09);
  --dark: var(--color-dark, #1a1a1a);
}

@keyframes fadeUp { from { opacity:0; transform:translateY(32px); } to { opacity:1; transform:none; } }
@keyframes scaleIn { from { opacity:0; transform:scaleX(0); } to { opacity:1; transform:scaleX(1); } }
@keyframes ticker { from { transform:translateX(0); } to { transform:translateX(-50%); } }
@keyframes scrollPulse { 0%,100% { transform:scaleY(1); opacity:.6; } 50% { transform:scaleY(1.6); opacity:1; } }

.eyebrow-light {
  font-size: 11px; font-weight: 600; letter-spacing: .22em;
  text-transform: uppercase; color: rgba(255,255,255,.65);
  margin-bottom: 16px; display: block;
}
.eyebrow {
  font-size: 11px; font-weight: 600; letter-spacing: .22em;
  text-transform: uppercase; color: var(--verde);
  margin-bottom: 16px; display: block;
}
.verde-rule {
  display: block; width: 52px; height: 2px;
  background: #F1CF64; margin: 18px 0;
}
.content-section { padding: 64px 6%; }

/* Separador entre secciones */
.section-divider {
  height: 1px;
