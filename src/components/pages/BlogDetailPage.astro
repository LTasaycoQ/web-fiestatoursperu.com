---
// src/components/pages/BlogDetailPage.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import { localePath } from "@i18n/index";
import type { Locale } from "@i18n/index";
import { getBlogPostBySlug } from "src/data/posts";
import type { ContentBlock } from "src/data/posts";

interface Props {
  lang: Locale;
  postId: string;
}

const { lang, postId } = Astro.props;
const post = getBlogPostBySlug(postId, lang);
if (!post) return Astro.redirect(`/${lang}/blog`);

const authorInitial = post.author.charAt(0);
const uiByLang = {
  es: {
    home: "Inicio", blog: "Blog", authorRole: "Escritor colaborador", readTime: "min de lectura",
    scroll: "Leer", share: "Compartir", shareX: "Compartir en X", shareFacebook: "Compartir en Facebook",
    shareWhatsApp: "Compartir en WhatsApp", shareLinkedIn: "Compartir en LinkedIn", copyLink: "Copiar enlace",
    tip: "Consejo del viajero", tags: "Etiquetas", newsletterEyebrow: "Mantente inspirado",
    newsletterTitle: "Historias de viaje<br />en tu bandeja", newsletterDescription: "Recibe mensualmente lo mejor de nuestro contenido: guías exclusivas, secretos locales y ofertas para viajeros exigentes.",
    email: "Tu correo electrónico", subscribe: "Suscribirme", privacy: "Sin spam. Cancela cuando quieras.",
    allArticles: "Todos los artículos", copied: "Enlace copiado", copyFailed: "No se pudo copiar el enlace",
  },
  en: {
    home: "Home", blog: "Journal", authorRole: "Contributing writer", readTime: "min read",
    scroll: "Read", share: "Share", shareX: "Share on X", shareFacebook: "Share on Facebook",
    shareWhatsApp: "Share on WhatsApp", shareLinkedIn: "Share on LinkedIn", copyLink: "Copy link",
    tip: "Traveler tip", tags: "Tags", newsletterEyebrow: "Stay inspired",
    newsletterTitle: "Travel stories<br />in your inbox", newsletterDescription: "Get the best of our content each month: exclusive guides, local secrets and offers for discerning travelers.",
    email: "Your email address", subscribe: "Subscribe", privacy: "No spam. Unsubscribe at any time.",
    allArticles: "All stories", copied: "Link copied", copyFailed: "Could not copy the link",
  },
  pt: {
    home: "Início", blog: "Blog", authorRole: "Escritor colaborador", readTime: "min de leitura",
    scroll: "Leia", share: "Compartilhar", shareX: "Compartilhar no X", shareFacebook: "Compartilhar no Facebook",
    shareWhatsApp: "Compartilhar no WhatsApp", shareLinkedIn: "Compartilhar no LinkedIn", copyLink: "Copiar link",
    tip: "Dica do viajante", tags: "Tags", newsletterEyebrow: "Continue inspirado",
    newsletterTitle: "Histórias de viagem<br />no seu e-mail", newsletterDescription: "Receba mensalmente o melhor do nosso conteúdo: guias exclusivos, segredos locais e ofertas para viajantes exigentes.",
    email: "Seu e-mail", subscribe: "Inscrever-se", privacy: "Sem spam. Cancele quando quiser.",
    allArticles: "Todos os artigos", copied: "Link copiado", copyFailed: "Não foi possível copiar o link",
  },
};
const ui = uiByLang[lang];
const tagLabels: Record<string, Record<string, string>> = {
  en: {
    montaña: "mountain",
    aventura: "adventure",
    cusco: "Cusco",
    naturaleza: "nature",
    vinicunca: "Vinicunca",
    trekking: "trekking",
  },
  pt: {
    montaña: "montanha",
    aventura: "aventura",
    cusco: "Cusco",
    naturaleza: "natureza",
    vinicunca: "Vinicunca",
    trekking: "trilha",
  },
  es: {},
};
---

<BaseLayout title={post.title} description={post.excerpt}>
  <main class="blog-detail-main">
    <div class="progress" id="progress"></div>

    <section class="blog-detail-hero">
      <div class="blog-detail-hero__bg">
        <img
          src={post.image}
          alt={post.title}
          fetchpriority="high"
        />
      </div>
      <div class="blog-detail-hero__overlay"></div>

      <div class="blog-detail-hero__content">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={localePath(lang, "/")}>{ui.home}</a>
          <span>/</span>
          <a href={localePath(lang, "/blog")}>{ui.blog}</a>
          <span>/</span>
          <span class="hero-breadcrumb__active">{post.category}</span>
        </nav>

        <div class="hero-category">{post.category}</div>

        <h1 class="blog-detail-hero__title">{post.title}</h1>

        <div class="hero-rule"></div>

        <div class="blog-detail-hero__meta">
          <div class="hero-author">
            <div class="hero-author__avatar" aria-hidden="true">{authorInitial}</div>
            <div class="hero-author__info">
              <span class="hero-author__name">{post.author}</span>
              <span class="hero-author__role">{ui.authorRole}</span>
            </div>
          </div>
          <div class="hero-meta-divider"></div>
          <div class="hero-stat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {post.readTime} {ui.readTime}
          </div>
          <div class="hero-stat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {post.date}
          </div>
        </div>
      </div>

      <div class="blog-detail-hero__scroll" aria-hidden="true">
        <span class="scroll-line"></span>
        <span class="scroll-label">{ui.scroll}</span>
      </div>
    </section>

    <div class="detail-canvas">
      <aside class="detail-share" aria-label={ui.share}>
        <div class="detail-share__sticky">
          <span class="detail-share__label">{ui.share}</span>
          <div class="detail-share__rule"></div>
          <button class="detail-share__btn" aria-label={ui.shareX} id="btnX">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </button>
          <button class="detail-share__btn" aria-label={ui.shareFacebook} id="btnFb">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path>
            </svg>
          </button>
          <button class="detail-share__btn" aria-label={ui.shareWhatsApp} data-share="whatsapp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M20.52 3.48A11.87 11.87 0 0 0 12.08 0C5.5 0 .14 5.35.14 11.94c0 2.1.55 4.15 1.6 5.96L0 24l6.25-1.64a11.92 11.92 0 0 0 5.82 1.48h.01c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.19-3.5-8.42Zm-8.44 18.34a9.9 9.9 0 0 1-5.05-1.39l-.36-.21-3.71.97.99-3.62-.23-.37a9.9 9.9 0 1 1 8.36 4.62Zm5.43-7.42c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.76-1.67-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37s-1.04 1.01-1.04 2.47 1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.09 4.49.71.3 1.27.49 1.7.62.72.23 1.37.2 1.88.12.58-.09 1.75-.72 2-1.42.25-.7.25-1.31.17-1.43-.07-.12-.27-.2-.57-.35Z"></path>
            </svg>
          </button>
          <button class="detail-share__btn" aria-label={ui.shareLinkedIn} data-share="linkedin">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V8.99h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.3ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V8.99h3.56v11.46ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path>
            </svg>
          </button>
        
          <button class="detail-share__btn" aria-label={ui.copyLink} id="btnCopy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
              <path d="M13.828 10.172a4 4 0 0 0-5.656 0l-4 4a4 4 0 1 0 5.656 5.656l1.102-1.102" stroke-linecap="round"></path>
              <path d="M10.172 13.828a4 4 0 0 0 5.656 0l4-4a4 4 0 0 0-5.656-5.656l-1.102 1.102" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </aside>

      <article class="detail-body">
        {
          post.blocks.map((block: ContentBlock) => {
            if (block.type === "lead")
              return <p class="detail-body__lead">{block.text}</p>;

            if (block.type === "heading2")
              return (
                <h2 class="detail-heading2" id={block.id}>
                  {block.text}
                </h2>
              );

            if (block.type === "heading3")
              return <h3 class="detail-heading3">{block.text}</h3>;

            if (block.type === "paragraph")
              return <p class="detail-paragraph">{block.text}</p>;

            if (block.type === "image")
              return (
                <figure class="detail-figure">
                  <img class="detail-img" src={block.src} alt={block.alt} loading="lazy" />
                  {block.caption && (
                    <figcaption class="detail-caption">{block.caption}</figcaption>
                  )}
                </figure>
              );

            if (block.type === "gallery")
              return (
                <div class="detail-gallery">
                  {block.images.map((img) => (
                    <figure class="detail-gallery__item">
                      <img class="detail-gallery__img" src={img.src} alt={img.alt} loading="lazy" />
                      {img.caption && (
                        <figcaption class="detail-gallery__caption">{img.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              );

            if (block.type === "moment")
              return (
                <div class="detail-moment">
                  <div class="detail-moment__header">
                    <span class="detail-moment__time">{block.time}</span>
                    <span class="detail-moment__sep">·</span>
                    <span class="detail-moment__place">{block.place}</span>
                  </div>
                  <p class="detail-moment__text">{block.text}</p>
                </div>
              );

            if (block.type === "dialogue")
              return (
                <div class="detail-dialogue">
                  <div class="detail-dialogue__line">
                    <span class="detail-dialogue__speaker">{block.speaker}</span>
                    <p class="detail-dialogue__text">&ldquo;{block.text}&rdquo;</p>
                  </div>
                  {block.response && (
                    <p class="detail-dialogue__response">{block.response}</p>
                  )}
                </div>
              );

            if (block.type === "feeling")
              return <p class="detail-feeling">{block.text}</p>;

            if (block.type === "features")
              return (
                <ul class="detail-features">
                  {block.items.map((item) => (
                    <li class="detail-features__item">
                      <div class="detail-features__dot" aria-hidden="true" />
                      <div>
                        <strong class="detail-features__title">{item.title}</strong>
                        <span class="detail-features__desc">{item.description}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              );

            if (block.type === "list")
              return (
                <ul class="detail-list">
                  {block.items.map((item) => (
                    <li class="detail-list__item">{item}</li>
                  ))}
                </ul>
              );

            if (block.type === "quote")
              return (
                <blockquote class="detail-quote">
                  <p>{block.text}</p>
                  {block.cite && <cite>{block.cite}</cite>}
                </blockquote>
              );

            if (block.type === "tip")
              return (
                <aside class="detail-tip">
                  <span class="detail-tip__label">{block.label || ui.tip}</span>
                  <p>{block.text}</p>
                </aside>
              );
          })
        }

        {
          post.tags && post.tags.length > 0 && (
            <div class="detail-tags">
              <span class="detail-tags__label">{ui.tags}</span>
              <div class="detail-tags__list">
                {post.tags.map((tag) => (
                  <a href={localePath(lang, `/blog?tag=${tag}`)} class="detail-tag">
                    #{tagLabels[lang][tag] ?? tag}
                  </a>
                ))}
              </div>
            </div>
          )
        }

      </article>
    </div>

    <section class="detail-newsletter">
      <div class="detail-newsletter__deco" aria-hidden="true">
        <span class="deco-circle deco-circle--1"></span>
        <span class="deco-circle deco-circle--2"></span>
      </div>
      <div class="detail-newsletter__inner">
        <span class="detail-newsletter__eyebrow">{ui.newsletterEyebrow}</span>
        <h2 class="detail-newsletter__title" set:html={ui.newsletterTitle}></h2>
        <div class="newsletter-rule"></div>
        <p class="detail-newsletter__desc">
          {ui.newsletterDescription}
        </p>
        <form class="detail-newsletter__form" id="newsletterForm" novalidate>
          <div class="nl-form-group">
            <input
              type="email"
              required
              placeholder={ui.email}
              class="detail-newsletter__input"
              aria-label={ui.email}
            />
            <button type="submit" class="detail-newsletter__btn">{ui.subscribe}</button>
          </div>
          <p class="detail-newsletter__note">{ui.privacy}</p>
        </form>
      </div>
    </section>

    <!-- ══ FOOTER NAV ════════════════════════════════════ -->
    <footer class="detail-footer">
      <div class="detail-footer__inner">
        <a href={localePath(lang, "/blog")} class="detail-back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          {ui.allArticles}
        </a>
      </div>
    </footer>

    <!-- Toast -->
    <div class="detail-toast" id="toast" role="status" aria-live="polite" data-copied={ui.copied} data-copy-failed={ui.copyFailed}></div>
  </main>
</BaseLayout>

<script>
  const shareUrl = window.location.href;
  const shareTitle = document.title;
  const shareText = `${shareTitle} ${shareUrl}`;
  const articleImage = document.querySelector<HTMLImageElement>(".blog-detail-hero__bg img")?.src ?? "";
  const toast = document.querySelector<HTMLElement>("#toast");
  const copiedMessage = toast?.dataset.copied ?? "";
  const copyFailedMessage = toast?.dataset.copyFailed ?? "";

  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add("show");
    window.setTimeout(() => toast.classList.remove("show"), 2200);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((button) => {
    button.addEventListener("click", () => {
      const network = button.dataset.share;
      const encodedUrl = encodeURIComponent(shareUrl);
      const encodedTitle = encodeURIComponent(shareTitle);
      const encodedText = encodeURIComponent(shareText);
      const destinations: Record<string, string> = {
        whatsapp: `https://api.whatsapp.com/send?text=${encodedText}`,
        linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
        pinterest: `https://pinterest.com/pin/create/button/?url=${encodedUrl}&media=${encodeURIComponent(articleImage)}&description=${encodedTitle}`,
      };

      if (network && destinations[network]) {
        window.open(destinations[network], "_blank", "noopener,noreferrer");
      }
    });
  });

  document.querySelector<HTMLButtonElement>("#btnX")?.addEventListener("click", () => {
    const destination = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(shareUrl)}`;
    window.open(destination, "_blank", "noopener,noreferrer");
  });

  document.querySelector<HTMLButtonElement>("#btnFb")?.addEventListener("click", () => {
    const destination = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
    window.open(destination, "_blank", "noopener,noreferrer");
  });

  document.querySelector<HTMLButtonElement>("#btnCopy")?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(shareUrl);
      showToast(copiedMessage);
    } catch {
      const input = document.createElement("textarea");
      input.value = shareUrl;
      input.setAttribute("readonly", "");
      input.style.position = "fixed";
      input.style.opacity = "0";
      document.body.append(input);
      input.select();
      const copied = document.execCommand("copy");
      input.remove();
      showToast(copied ? copiedMessage : copyFailedMessage);
    }
  });
</script>

<style>
/* ═══════════════════════════════════════════════════════════════ */
/* BLOG DETAIL PAGE — FONDO BLANCO PURO                            */
/* Contenido más ancho, eliminados espacios negros laterales       */
/* ═══════════════════════════════════════════════════════════════ */

/* ── Design tokens (tonos verdes) ─────────────────────────────── */
:root {
  --verde:       #3e4b3c;
  --verdec:      #478a3d;
  --verde-claro: #5a9a50;
  --verde-light: rgba(62, 75, 60, 0.08);
  --verde-border: rgba(62, 75, 60, 0.12);
  --verde-gradient: linear-gradient(135deg, var(--verdec), var(--verde));
  --ink:         #1a1a1a;
  --ink-mid:     #2d2d2d;
  --ink-soft:    #6b6b6b;
  --cream:       #ffffff;
  --cream-mid:   #f8f9f8;
  --off-white:   #fafbfa;
  --rule:        rgba(0, 0, 0, 0.08);
  --ff-display: 'Cormorant Garamond', Georgia, serif;
  --ff-body:    'DM Sans', system-ui, sans-serif;
  --ease:       cubic-bezier(0.22, 1, 0.36, 1);
}

/* ── Fondo global blanco ──────────────────────────────────────── */
.blog-detail-main {
  background: #ffffff;
  font-family: var(--font-ppnue);
}

/* ── Progress bar (verde) ────────────────────────────────────── */
.progress {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  height: 2px;
  width: 0%;
  background: var(--verdec);
  transition: width 0.15s linear;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════ */
/* HERO CINEMATOGRÁFICO                                            */
/* ═══════════════════════════════════════════════════════════════ */
.blog-detail-hero {
  position: relative;
  height: 80vh;
  min-height: 580px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  background: var(--verde);
  margin-top: -72px;
  padding-top: 72px;
}

@media (max-width: 768px) {
  .blog-detail-hero {
    min-height: 520px;
    justify-content: center;
    text-align: center;
  }
}

.blog-detail-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.blog-detail-hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
  transition: transform 12s var(--ease);
  transform: scale(1.04);
}

.blog-detail-hero:hover .blog-detail-hero__bg img {
  transform: scale(1);
}

.blog-detail-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(to right, rgba(10,12,10,0.85) 0%, rgba(10,12,10,0.5) 52%, rgba(10,12,10,0.25) 100%),
    linear-gradient(to top, rgba(10,12,10,0.75) 0%, transparent 45%),
    linear-gradient(135deg, rgba(62,75,60,0.2) 0%, transparent 55%);
}

.blog-detail-hero__content {
  position: relative;
  z-index: 3;
  max-width: 1700px;
  width: 100%;
  margin: 0 auto;
  padding: 60px 6% 80px;
}

@media (max-width: 768px) {
  .blog-detail-hero__content {
    padding: 80px 5% 60px;
    text-align: center;
  }
}

/* Breadcrumb */
.hero-breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

@media (max-width: 768px) {
  .hero-breadcrumb { justify-content: center; }
}

.hero-breadcrumb a {
  color: rgba(255, 255, 255, 0.5);
  text-decoration: none;
  transition: color 0.2s;
}

.hero-breadcrumb a:hover { color: var(--verdec); }

.hero-breadcrumb span {
  color: rgba(255, 255, 255, 0.25);
}

.hero-breadcrumb__active {
  color: var(--verdec) !important;
}

/* Categoría badge */
.hero-category {
  display: inline-flex;
  align-items: center;
  padding: 5px 16px;
  margin-bottom: 24px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--verdec);
  border: 1px solid rgba(71, 138, 61, 0.5);
  border-radius: 2px;
  background: rgba(62, 75, 60, 0.15);
  backdrop-filter: blur(4px);
}

@media (max-width: 768px) {
  .hero-category { margin: 0 auto 24px; }
}

/* Título */
.blog-detail-hero__title {
  font-family: var(--font-ppnue);
  font-size: clamp(38px, 5.5vw, 80px);
  font-weight: 400;
  color: #fff;
  line-height: 1.08;
  margin: 0 0 24px;
  letter-spacing: -0.02em;
  max-width: 800px;
}

@media (max-width: 768px) {
  .blog-detail-hero__title {
    font-size: clamp(30px, 7vw, 48px);
    margin: 0 auto 24px;
    text-align: center;
  }
}

/* Línea decorativa */
.hero-rule {
  width: 56px;
  height: 2px;
  background: linear-gradient(to right, var(--verdec), rgba(71, 138, 61, 0.3));
  margin: 0 0 28px;
}

@media (max-width: 768px) {
  .hero-rule { margin: 0 auto 28px; }
}

/* Meta información */
.blog-detail-hero__meta {
  display: flex;
  align-items: center;
  gap: 32px;
  flex-wrap: wrap;
}

@media (max-width: 768px) {
  .blog-detail-hero__meta {
    justify-content: center;
    gap: 20px;
  }
}

.hero-author {
  display: flex;
  align-items: center;
  gap: 12px;
}

.hero-author__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--verde-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  border: 2px solid rgba(255, 255, 255, 0.2);
}

.hero-author__info {
  display: flex;
  flex-direction: column;
}

.hero-author__name {
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
}

.hero-author__role {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0.04em;
}

.hero-meta-divider {
  width: 1px;
  height: 32px;
  background: rgba(255, 255, 255, 0.15);
}

@media (max-width: 480px) {
  .hero-meta-divider { display: none; }
}

.hero-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.02em;
}

/* Scroll indicator */
.blog-detail-hero__scroll {
  position: absolute;
  bottom: 36px;
  right: 6%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

@media (max-width: 768px) {
  .blog-detail-hero__scroll { display: none; }
}

.scroll-line {
  display: block;
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.18), transparent);
  animation: scrollLineAnim 2s ease-in-out infinite;
}

@keyframes scrollLineAnim {
  0% { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

.scroll-label {
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.28);
  writing-mode: vertical-rl;
  font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════ */
/* CANVAS PRINCIPAL — FONDO BLANCO, CONTENIDO MÁS ANCHO           */
/* ═══════════════════════════════════════════════════════════════ */
.detail-canvas {
  max-width: 1700px;
  margin: 0 auto;
  padding: 64px 6% 100px;
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr);
  gap: 48px;
  background: #ffffff;
}

@media (max-width: 1200px) {
  .detail-canvas {
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 36px;
    padding: 56px 5% 80px;
  }
}

@media (max-width: 1000px) {
  .detail-canvas {
    grid-template-columns: 48px 1fr;
    gap: 32px;
  }
}

@media (max-width: 768px) {
  .detail-canvas {
    grid-template-columns: 1fr;
    padding: 40px 5% 60px;
  }
  .detail-share__sticky {
    position: static;
    flex-direction: row;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .detail-share__label { writing-mode: horizontal-tb; }
  .detail-share__rule { width: 1px; height: 24px; }
}

/* ══ SHARE COLUMN ═══════════════════════════════════════════════ */
.detail-share__sticky {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
}

.detail-share__label {
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--ink-soft);
  writing-mode: vertical-rl;
}

.detail-share__rule {
  width: 1px;
  height: 48px;
  background: var(--rule);
}

.detail-share__btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--rule);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s var(--ease);
  color: var(--ink-soft);
}

.detail-share__btn:hover {
  background: var(--verdec);
  border-color: var(--verdec);
  color: #fff;
  transform: scale(1.08);
  box-shadow: 0 6px 20px rgba(71, 138, 61, 0.3);
}

/* ══ ARTICLE BODY — MÁS ANCHO ═══════════════════════════════════ */
.detail-body {
  min-width: 0;
  max-width: 100%;
}

.detail-body__lead {
  font-size: 20px;
  font-weight: 400;
  line-height: 1.65;
  color: var(--ink-mid);
  margin-bottom: 48px;
  padding-bottom: 40px;
  border-bottom: 1px solid var(--rule);
  font-family: var(--ff-ppnue);
}

.detail-heading2 {
  font-size: 28px;
  font-weight: 500;
  font-family: var(--ff-ppnue);
  line-height: 1.3;
  color: var(--ink);
  letter-spacing: -0.01em;
  margin: 48px 0 20px;
  padding-top: 24px;
  scroll-margin-top: 90px;
}

.detail-heading3 {
  font-size: 20px;
  font-weight: 500;
  font-family: var(--ff-ppnue);
  color: var(--ink-mid);
  margin: 32px 0 14px;
}

.detail-paragraph {
  font-size: 16px;
  line-height: 1.85;
  color: var(--ink-mid);
  margin-bottom: 24px;
  font-weight: 400;
}

/* Drop cap */
.detail-body__lead + .detail-heading2 + .detail-paragraph::first-letter,
.detail-body__lead + .detail-paragraph::first-letter {
  font-size: 64px;
  font-weight: 600;
  float: left;
  line-height: 0.78;
  margin: 6px 14px 0 0;
  color: var(--verdec);
}

/* ══ FIGURE E IMAGENES ══════════════════════════════════════════ */
.detail-figure {
  margin: 48px 0;
}

.detail-img {
  width: 100%;
  display: block;
  border-radius: 4px;
  box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.12);
}

.detail-caption {
  font-size: 12px;
  letter-spacing: 0.04em;
  color: var(--ink-soft);
  text-align: center;
  margin-top: 14px;
}

/* ══ GALLERY ════════════════════════════════════════════════════ */
.detail-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin: 48px 0;
}

.detail-gallery__item {
  margin: 0;
}

.detail-gallery__img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  border-radius: 4px;
  display: block;
  box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.1);
  transition: transform 0.4s var(--ease);
}

.detail-gallery__item:hover .detail-gallery__img {
  transform: scale(1.02);
}

.detail-gallery__caption {
  font-size: 11px;
  color: var(--ink-soft);
  text-align: center;
  margin-top: 8px;
}

/* ══ MOMENT ═════════════════════════════════════════════════════ */
.detail-moment {
  margin: 44px 0;
  padding: 28px 32px;
  background: var(--cream-mid);
  border-left: 3px solid var(--verdec);
  border-radius: 0 4px 4px 0;
}

.detail-moment__header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
}

.detail-moment__time {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--verdec);
}

.detail-moment__sep { color: var(--rule); }

.detail-moment__place {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-soft);
}

.detail-moment__text {
  font-size: 16px;
  line-height: 1.75;
  color: var(--ink-mid);
  font-style: italic;
  margin: 0;
}

/* ══ DIALOGUE ═══════════════════════════════════════════════════ */
.detail-dialogue {
  margin: 40px 0;
  padding: 28px 32px;
  border: 1px solid var(--rule);
  border-radius: 4px;
  background: #fff;
}

.detail-dialogue__speaker {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--verdec);
  margin-bottom: 8px;
}

.detail-dialogue__text {
  font-size: 17px;
  line-height: 1.7;
  color: var(--ink);
  font-style: italic;
  margin: 0;
}

.detail-dialogue__response {
  font-size: 15px;
  line-height: 1.7;
  color: var(--ink-soft);
  margin: 12px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--rule);
}

/* ══ FEELING ════════════════════════════════════════════════════ */
.detail-feeling {
  font-size: 19px;
  font-style: italic;
  line-height: 1.65;
  color: var(--ink-soft);
  margin: 40px 0;
  padding: 0 0 0 24px;
  border-left: 2px solid var(--verdec);
}

/* ══ FEATURES LIST ══════════════════════════════════════════════ */
.detail-features {
  list-style: none;
  margin: 32px 0;
}

.detail-features__item {
  display: grid;
  grid-template-columns: 8px 1fr;
  gap: 0 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--rule);
}

.detail-features__item:first-child {
  border-top: 1px solid var(--rule);
}

.detail-features__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--verdec);
  margin-top: 6px;
}

.detail-features__title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 4px;
}

.detail-features__desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-soft);
}

/* ══ LISTA ══════════════════════════════════════════════════════ */
.detail-list {
  list-style: none;
  margin: 24px 0;
}

.detail-list__item {
  padding: 12px 0 12px 20px;
  position: relative;
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-mid);
  border-bottom: 1px solid var(--rule);
}

.detail-list__item:first-child {
  border-top: 1px solid var(--rule);
}

.detail-list__item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--verdec);
}

/* ══ PULL QUOTE ═════════════════════════════════════════════════ */
.detail-quote {
  margin: 52px 0;
  padding: 36px 44px;
  background: var(--cream-mid);
  border-left: 3px solid var(--verdec);
  position: relative;
}

.detail-quote::before {
  content: "\201C";
  position: absolute;
  top: -14px;
  left: 32px;
  font-size: 96px;
  color: var(--verdec);
  opacity: 0.15;
  line-height: 1;
  pointer-events: none;
}

.detail-quote p {
  font-size: 21px;
  font-style: italic;
  line-height: 1.55;
  color: var(--ink);
  margin: 0;
}

.detail-quote cite {
  display: block;
  margin-top: 16px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--verdec);
  font-style: normal;
}

/* ══ TIP BOX ════════════════════════════════════════════════════ */
.detail-tip {
  margin: 44px 0;
  padding: 26px 30px;
  background: rgba(71, 138, 61, 0.05);
  border: 1px solid rgba(71, 138, 61, 0.15);
  border-radius: 4px;
}

.detail-tip__label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--verdec);
  display: block;
  margin-bottom: 12px;
}

.detail-tip p {
  font-size: 15px;
  line-height: 1.7;
  color: var(--ink-mid);
  margin: 0;
}

/* ══ TAGS ═══════════════════════════════════════════════════════ */
.detail-tags {
  margin-top: 72px;
  padding-top: 40px;
  border-top: 1px solid var(--rule);
}

.detail-tags__label {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-soft);
  display: block;
  margin-bottom: 16px;
}

.detail-tags__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.detail-tag {
  padding: 6px 18px;
  font-size: 12px;
  color: var(--verde);
  background: var(--cream-mid);
  border: 1px solid var(--verde-border);
  text-decoration: none;
  border-radius: 2px;
  transition: all 0.25s var(--ease);
}

.detail-tag:hover {
  background: var(--verdec);
  color: #fff;
  border-color: var(--verdec);
}

/* ══ AUTHOR INLINE (mobile) ═════════════════════════════════════ */
.detail-author-inline {
  display: none;
  margin-top: 56px;
  padding: 32px;
  background: var(--cream-mid);
  border: 1px solid var(--rule);
  border-radius: 4px;
  gap: 20px;
}

@media (max-width: 1000px) {
  .detail-author-inline { display: flex; }
}

@media (max-width: 480px) {
  .detail-author-inline { flex-direction: column; text-align: center; }
}

.detail-author__avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--verde-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 700;
  color: #fff;
}

@media (max-width: 480px) {
  .detail-author__avatar { margin: 0 auto; }
}

.detail-author__name {
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
}

.detail-author__role {
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--verdec);
  margin: 4px 0 10px;
}

.detail-author__bio {
  font-size: 13px;
  line-height: 1.65;
  color: var(--ink-soft);
}

/* ══ ASIDE (TOC + AUTHOR CARD) ══════════════════════════════════ */
.detail-aside__sticky {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.detail-toc {
  padding: 24px;
  background: #fff;
  border: 1px solid var(--rule);
  border-radius: 4px;
}

.detail-toc__title {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--verdec);
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--rule);
}

.detail-toc__list {
  list-style: none;
}

.detail-toc__item {
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.detail-toc__item:last-child { border: none; }

.detail-toc__link {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  text-decoration: none;
  font-size: 13px;
  line-height: 1.4;
  color: var(--ink-soft);
  transition: all 0.2s;
}

.detail-toc__link:hover,
.detail-toc__link.active {
  color: var(--verdec);
}

.detail-toc__num {
  font-size: 11px;
  font-style: italic;
  color: var(--ink-soft);
  opacity: 0.5;
  min-width: 20px;
}

.detail-toc__link.active .detail-toc__num {
  opacity: 1;
  color: var(--verdec);
}

/* Author Card */
.detail-author-card {
  padding: 28px;
  background: var(--cream-mid);
  border: 1px solid var(--rule);
  border-radius: 4px;
  text-align: center;
}

.detail-author-card__avatar {
  width: 70px;
  height: 70px;
  margin: 0 auto 14px;
  background: var(--verde-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
  color: #fff;
  border-radius: 50%;
}

.detail-author-card__name {
  font-size: 18px;
  font-weight: 600;
  color: var(--ink);
}

.detail-author-card__role {
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--verdec);
  margin: 4px 0 12px;
}

.detail-author-card__bio {
  font-size: 13px;
  line-height: 1.65;
  color: var(--ink-soft);
  margin-bottom: 18px;
}

.detail-author-card__social {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.detail-social-btn {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--rule);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-soft);
  text-decoration: none;
  transition: all 0.25s;
}

.detail-social-btn:hover {
  background: var(--verdec);
  border-color: var(--verdec);
  color: #fff;
}

/* ═══════════════════════════════════════════════════════════════ */
/* NEWSLETTER — fondo claro                                        */
/* ═══════════════════════════════════════════════════════════════ */
.detail-newsletter {
  background: var(--off-white);
  padding: 80px 6%;
  border-top: 1px solid var(--verde-border);
  position: relative;
  overflow: hidden;
}

@media (max-width: 768px) {
  .detail-newsletter { padding: 60px 5%; }
}

.detail-newsletter__deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(62, 75, 60, 0.08);
}

.deco-circle--1 {
  width: 500px;
  height: 500px;
  top: -200px;
  right: -100px;
}

.deco-circle--2 {
  width: 280px;
  height: 280px;
  bottom: -80px;
  left: 5%;
  border-style: dashed;
  opacity: 0.4;
}

.detail-newsletter__inner {
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
  position: relative;
  z-index: 1;
}

.detail-newsletter__eyebrow {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--verdec);
  display: inline-block;
  margin-bottom: 18px;
}

.detail-newsletter__title {
  font-family: var(--ff-ppnue);
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 400;
  line-height: 1.2;
  color: var(--ink);
  margin-bottom: 16px;
}

.newsletter-rule {
  width: 48px;
  height: 2px;
  background: var(--verdec);
  margin: 0 auto 20px;
}

.detail-newsletter__desc {
  font-size: 15px;
  line-height: 1.7;
  color: var(--ink-soft);
  margin-bottom: 36px;
}

.nl-form-group {
  display: flex;
  gap: 12px;
  max-width: 480px;
  margin: 0 auto;
}

@media (max-width: 560px) {
  .nl-form-group { flex-direction: column; }
}

.detail-newsletter__input {
  flex: 1;
  padding: 14px 20px;
  background: #fff;
  border: 1px solid var(--verde-border);
  border-radius: 4px;
  font-size: 14px;
  color: var(--ink);
  outline: none;
  transition: border-color 0.25s, box-shadow 0.25s;
}

.detail-newsletter__input:focus {
  border-color: var(--verdec);
  box-shadow: 0 0 0 3px rgba(71, 138, 61, 0.1);
}

.detail-newsletter__btn {
  padding: 14px 32px;
  background: var(--verdec);
  border: none;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #fff;
  cursor: pointer;
  transition: all 0.25s;
  white-space: nowrap;
}

.detail-newsletter__btn:hover {
  background: var(--verde);
  transform: translateY(-2px);
}

.detail-newsletter__note {
  font-size: 11px;
  color: var(--ink-soft);
  opacity: 0.6;
  margin-top: 18px;
}

/* ═══════════════════════════════════════════════════════════════ */
/* FOOTER                                                          */
/* ═══════════════════════════════════════════════════════════════ */
.detail-footer {
  background: #fff;
  border-top: 1px solid var(--rule);
  padding: 40px 6%;
}

.detail-footer__inner {
  max-width: 1600px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

@media (max-width: 640px) {
  .detail-footer__inner { flex-direction: column; gap: 20px; }
}

.detail-back-link {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--ink-soft);
  transition: all 0.25s;
}

.detail-back-link:hover {
  color: var(--verdec);
  gap: 16px;
}

.detail-footer-logo {
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  opacity: 0.5;
  text-decoration: none;
  letter-spacing: 0.06em;
}

.detail-footer-logo span {
  color: var(--verdec);
  opacity: 1;
}

/* ══ TOAST ══════════════════════════════════════════════════════ */
.detail-toast {
  position: fixed;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  z-index: 9999;
  opacity: 0;
  pointer-events: none;
  padding: 12px 28px;
  background: var(--ink);
  color: #fff;
  font-size: 13px;
  border-radius: 4px;
  transition: all 0.35s var(--ease);
}

.detail-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

/* ══ RESPONSIVE AJUSTES FINOS ═══════════════════════════════════ */
@media (max-width: 480px) {
  .detail-body__lead { font-size: 18px; }
  .detail-heading2 { font-size: 24px; }
  .detail-quote { padding: 24px 20px; }
  .detail-quote p { font-size: 18px; }
  .detail-moment { padding: 20px; }
  .detail-dialogue { padding: 20px; }
  .detail-features__item { gap: 12px; }
}

/* ══ REDUCCIÓN DE MOVIMIENTO ════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .blog-detail-hero__bg img,
  .detail-gallery__img { transition: none !important; }
  .scroll-line { animation: none !important; }
}

/* ══ iOS SAFARI FIX ═════════════════════════════════════════════ */
@supports (-webkit-touch-callout: none) {
  .blog-detail-hero {
    min-height: -webkit-fill-available !important;
  }
}
</style>
