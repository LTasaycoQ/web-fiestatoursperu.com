---
// src/components/pages/BlogDetailPage.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations, localePath } from "@i18n/index";
import type { Locale } from "@i18n/index";
import { getBlogPostBySlug } from "src/data/posts";
import type { ContentBlock } from "src/data/posts";

interface Props {
  lang: Locale;
  postId: string;
}

const { lang, postId } = Astro.props;
const t = useTranslations(lang);

const post = getBlogPostBySlug(postId);
if (!post) return Astro.redirect(`/${lang}/blog`);

const authorInitial = post.author.charAt(0);
---

<BaseLayout title={post.title} description={post.excerpt}>
  <main class="blog-detail-main">
    <div class="progress" id="progress"></div>

    <section class="blog-detail-hero">
      <div class="blog-detail-hero__bg">
        <img
          src={post.image}
          alt={post.title}
          fetchpriority="high"
        />
      </div>
      <div class="blog-detail-hero__overlay"></div>

      <div class="blog-detail-hero__content">
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <a href={localePath(lang, "/")}>Inicio</a>
          <span>/</span>
          <a href={localePath(lang, "/blog")}>Blog</a>
          <span>/</span>
          <span class="hero-breadcrumb__active">{post.category}</span>
        </nav>

        <div class="hero-category">{post.category}</div>

        <h1 class="blog-detail-hero__title">{post.title}</h1>

        <div class="hero-rule"></div>

        <div class="blog-detail-hero__meta">
          <div class="hero-author">
            <div class="hero-author__avatar" aria-hidden="true">{authorInitial}</div>
            <div class="hero-author__info">
              <span class="hero-author__name">{post.author}</span>
              <span class="hero-author__role">Escritor Colaborador</span>
            </div>
          </div>
          <div class="hero-meta-divider"></div>
          <div class="hero-stat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {post.readTime} min lectura
          </div>
          <div class="hero-stat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {post.date}
          </div>
        </div>
      </div>

      <div class="blog-detail-hero__scroll" aria-hidden="true">
        <span class="scroll-line"></span>
        <span class="scroll-label">Leer</span>
      </div>
    </section>

    <div class="detail-canvas">
      <aside class="detail-share" aria-label="Compartir artículo">
        <div class="detail-share__sticky">
          <span class="detail-share__label">Compartir</span>
          <div class="detail-share__rule"></div>
          <button class="detail-share__btn" aria-label="Compartir en X" id="btnX">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </button>
          <button class="detail-share__btn" aria-label="Compartir en Facebook" id="btnFb">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path>
            </svg>
          </button>
          <button class="detail-share__btn" aria-label="Copiar enlace" id="btnCopy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
              <path d="M13.828 10.172a4 4 0 0 0-5.656 0l-4 4a4 4 0 1 0 5.656 5.656l1.102-1.102" stroke-linecap="round"></path>
              <path d="M10.172 13.828a4 4 0 0 0 5.656 0l4-4a4 4 0 0 0-5.656-5.656l-1.102 1.102" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>
      </aside>

      <article class="detail-body">
        {
          post.blocks.map((block: ContentBlock) => {
            if (block.type === "lead")
              return <p class="detail-body__lead">{block.text}</p>;

            if (block.type === "heading2")
              return (
                <h2 class="detail-heading2" id={block.id}>
                  {block.text}
                </h2>
              );

            if (block.type === "heading3")
              return <h3 class="detail-heading3">{block.text}</h3>;

            if (block.type === "paragraph")
              return <p class="detail-paragraph">{block.text}</p>;

            if (block.type === "image")
              return (
                <figure class="detail-figure">
                  <img class="detail-img" src={block.src} alt={block.alt} loading="lazy" />
                  {block.caption && (
                    <figcaption class="detail-caption">{block.caption}</figcaption>
                  )}
                </figure>
              );

            if (block.type === "gallery")
              return (
                <div class="detail-gallery">
                  {block.images.map((img) => (
                    <figure class="detail-gallery__item">
                      <img class="detail-gallery__img" src={img.src} alt={img.alt} loading="lazy" />
                      {img.caption && (
                        <figcaption class="detail-gallery__caption">{img.caption}</figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              );

            if (block.type === "moment")
              return (
                <div class="detail-moment">
                  <div class="detail-moment__header">
                    <span class="detail-moment__time">{block.time}</span>
                    <span class="detail-moment__sep">·</span>
                    <span class="detail-moment__place">{block.place}</span>
                  </div>
                  <p class="detail-moment__text">{block.text}</p>
                </div>
              );

            if (block.type === "dialogue")
              return (
                <div class="detail-dialogue">
                  <div class="detail-dialogue__line">
                    <span class="detail-dialogue__speaker">{block.speaker}</span>
                    <p class="detail-dialogue__text">&ldquo;{block.text}&rdquo;</p>
                  </div>
                  {block.response && (
                    <p class="detail-dialogue__response">{block.response}</p>
                  )}
                </div>
              );

            if (block.type === "feeling")
              return <p class="detail-feeling">{block.text}</p>;

            if (block.type === "features")
              return (
                <ul class="detail-features">
                  {block.items.map((item) => (
                    <li class="detail-features__item">
                      <div class="detail-features__dot" aria-hidden="true" />
                      <div>
                        <strong class="detail-features__title">{item.title}</strong>
                        <span class="detail-features__desc">{item.description}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              );

            if (block.type === "list")
              return (
                <ul class="detail-list">
                  {block.items.map((item) => (
                    <li class="detail-list__item">{item}</li>
                  ))}
                </ul>
              );

            if (block.type === "quote")
              return (
                <blockquote class="detail-quote">
                  <p>{block.text}</p>
                  {block.cite && <cite>{block.cite}</cite>}
                </blockquote>
              );

            if (block.type === "tip")
              return (
                <aside class="detail-tip">
                  <span class="detail-tip__label">{block.label || "Consejo del viajero"}</span>
                  <p>{block.text}</p>
                </aside>
              );
          })
        }

        <!-- Tags -->
        {
          post.tags && post.tags.length > 0 && (
            <div class="detail-tags">
              <span class="detail-tags__label">Etiquetas</span>
              <div class="detail-tags__list">
                {post.tags.map((tag) => (
                  <a href={localePath(lang, `/blog?tag=${tag}`)} class="detail-tag">
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Author bio inline (visible en mobile) -->
        <div class="detail-author-inline">
          <div class="detail-author__avatar" aria-hidden="true">{authorInitial}</div>
          <div class="detail-author__info">
            <p class="detail-author__name">{post.author}</p>
            <p class="detail-author__role">Escritor Colaborador · Vinicunca</p>
            {post.authorBio && <p class="detail-author__bio">{post.authorBio}</p>}
          </div>
        </div>
      </article>

      <!-- Aside: TOC + Author -->
      <aside class="detail-aside" aria-label="Índice del artículo">
        <div class="detail-aside__sticky">
          {
            post.toc && post.toc.length > 0 && (
              <nav class="detail-toc">
                <p class="detail-toc__title">En este artículo</p>
                <ol class="detail-toc__list">
                  {post.toc.map((item, i) => (
                    <li class="detail-toc__item">
                      <a href={`#${item.id}`} class="detail-toc__link" data-toc-id={item.id}>
                        <span class="detail-toc__num">0{i + 1}</span>
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }

          <div class="detail-author-card">
            <div class="detail-author-card__avatar" aria-hidden="true">{authorInitial}</div>
            <p class="detail-author-card__name">{post.author}</p>
            <p class="detail-author-card__role">Escritor Colaborador</p>
            {post.authorBio && <p class="detail-author-card__bio">{post.authorBio}</p>}
            <div class="detail-author-card__social">
              <a href="#" class="detail-social-btn" aria-label="Seguir en X">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
              </a>
              <a href="#" class="detail-social-btn" aria-label="Seguir en Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                  <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r=".5" fill="currentColor"></circle>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- ══ NEWSLETTER ════════════════════════════════════ -->
    <section class="detail-newsletter">
      <div class="detail-newsletter__deco" aria-hidden="true">
        <span class="deco-circle deco-circle--1"></span>
        <span class="deco-circle deco-circle--2"></span>
      </div>
      <div class="detail-newsletter__inner">
        <span class="detail-newsletter__eyebrow">Mantente inspirado</span>
        <h2 class="detail-newsletter__title">Historias de la Montaña<br />en tu bandeja</h2>
        <div class="newsletter-rule"></div>
        <p class="detail-newsletter__desc">
          Recibe lo mejor de nuestro contenido mensualmente: guías exclusivas,
          secretos locales y ofertas para viajeros exigentes.
        </p>
        <form class="detail-newsletter__form" id="newsletterForm" novalidate>
          <div class="nl-form-group">
            <input
              type="email"
              required
              placeholder="Tu correo electrónico"
              class="detail-newsletter__input"
              aria-label="Correo electrónico"
            />
            <button type="submit" class="detail-newsletter__btn">Suscribirme</button>
          </div>
          <p class="detail-newsletter__note">Sin spam. Cancela cuando quieras.</p>
        </form>
      </div>
    </section>

    <!-- ══ FOOTER NAV ════════════════════════════════════ -->
    <footer class="detail-footer">
      <div class="detail-footer__inner">
        <a href={localePath(lang, "/blog")} class="detail-back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Todos los artículos
        </a>
        <a href={localePath(lang, "/")} class="detail-footer-logo">Amazon<span>Cruises</span></a>
      </div>
    </footer>

    <!-- Toast -->
    <div class="detail-toast" id="toast" role="status" aria-live="polite"></div>
  </main>
</BaseLayout>

<style>
/* ═══════════════════════════════════════════════════════════════ */
/* BLOG DETAIL PAGE — FONDO BLANCO PURO                            */
/* Contenido más ancho, eliminados espacios negros laterales       */
/* ═══════════════════════════════════════════════════════════════ */

/* ── Design tokens (tonos verdes) ─────────────────────────────── */
:root {
  --verde:       #3e4b3c;
  --verdec:      #478a3d;
  --verde-claro: #5a9a50;
  --verde-light: rgba(62, 75, 60, 0.08);
  --verde-border: rgba(62, 75, 60, 0.12);
  --verde-gradient: linear-gradient(135deg, var(--verdec), var(--verde));
  --ink:         #1a1a1a;
  --ink-mid:     #2d2d2d;
  --ink-soft:    #6b6b6b;
  --cream:       #ffffff;
  --cream-mid:   #f8f9f8;
  --off-white:   #fafbfa;
  --rule:        rgba(0, 0, 0, 0.08);
  --ff-display: 'Cormorant Garamond', Georgia, serif;
  --ff-body:    'DM Sans', system-ui, sans-serif;
  --ease:       cubic-bezier(0.22, 1, 0.36, 1);
}

/* ── Fondo global blanco ──────────────────────────────────────── */
.blog-detail-main {
  background: #ffffff;
}

/* ── Progress bar (verde) ────────────────────────────────────── */
.progress {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  height: 2px;
  width: 0%;
  background: var(--verdec);
  transition: width 0.15s linear;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════ */
/* HERO CINEMATOGRÁFICO                                            */
/* ═══════════════════════════════════════════════════════════════ */
.blog-detail-hero {
  position: relative;
  height: 80vh;
  min-height: 580px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  background: var(--verde);
  margin-top: -72px;
  padding-top: 72px;
}

@media (max-width: 768px) {
  .blog-detail-hero {
    min-height: 520px;
    justify-content: center;
    text-align: center;
  }
}

.blog-detail-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.blog-detail-hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
  transition: transform 12s var(--ease);
  transform: scale(1.04);
}

.blog-detail-hero:hover .blog-detail-hero__bg img {
  transform: scale(1);
}

.blog-detail-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(to right, rgba(10,12,10,0.85) 0%, rgba(10,12,10,0.5) 52%, rgba(10,12,10,0.25) 100%),
    linear-gradient(to top, rgba(10,12,10,0.75) 0%, transparent 45%),
    linear-gradient(135deg, rgba(62,75,60,0.2) 0%, transparent 55%);
}

.blog-detail-hero__content {
  position: relative;
  z-index: 3;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  padding: 60px 6% 80px;
}

@media (max-width: 768px) {
  .blog-detail-hero__content {
    padding: 80px 5% 60px;
    text-align: center;
  }
}

/* Breadcrumb */
.hero-breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

@media (max-width: 768px) {
  .hero-breadcrumb { justify-content: center; }
}

.hero-breadcrumb a {
  color: rgba(255, 255, 255, 0.5);
  text-decoration: none;
  transition: color 0.2s;
}

.hero-breadcrumb a:hover { color: var(--verdec); }

.hero-breadcrumb span {
  color: rgba(255, 255, 255, 0.25);
}

.hero-breadcrumb__active {
  color: var(--verdec) !important;
}

/* Categoría badge */
.hero-category {
  display: inline-flex;
  align-items: center;
  padding: 5px 16px;
  margin-bottom: 24px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--verdec);
  border: 1px solid rgba(71, 138, 61, 0.5);
  border-radius: 2px;
  background: rgba(62, 75, 60, 0.15);
  backdrop-filter: blur(4px);
}

@media (max-width: 768px) {
  .hero-category { margin: 0 auto 24px; }
}

/* Título */
.blog-detail-hero__title {
  font-family: var(--ff-display);
  font-size: clamp(38px, 5.5vw, 80px);
  font-weight: 400;
  color: #fff;
  line-height: 1.08;
  margin: 0 0 24px;
  letter-spacing: -0.02em;
  max-width: 800px;
}

@media (max-width: 768px) {
  .blog-detail-hero__title {
    font-size: clamp(30px, 7vw, 48px);
    margin: 0 auto 24px;
    text-align: center;
  }
}

/* Línea decorativa */
.hero-rule {
  width: 56px;
  height: 2px;
  background: linear-gradient(to right, var(--verdec), rgba(71, 138, 61, 0.3));
  margin: 0 0 28px;
}

@media (max-width: 768px) {
  .hero-rule { margin: 0 auto 28px; }
}

/* Meta información */
.blog-detail-hero__meta {
  display: flex;
  align-items: center;
  gap: 32px;
  flex-wrap: wrap;
}

@media (max-width: 768px) {
  .blog-detail-hero__meta {
    justify-content: center;
    gap: 20px;
  }
}

.hero-author {
  display: flex;
  align-items: center;
  gap: 12px;
}

.hero-author__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--verde-gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  border: 2px solid rgba(255, 255, 255, 0.2);
}

.hero-author__info {
  display: flex;
  flex-direction: column;
}

.hero-author__name {
  font-size: 14px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
}

.hero-author__role {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 0.04em;
}

.hero-meta-divider {
  width: 1px;
  height: 32px;
  background: rgba(255, 255, 255, 0.15);
}

@media (max-width: 480px) {
  .hero-meta-divider { display: none; }
}

.hero-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 0.02em;
}

/* Scroll indicator */
.blog-detail-hero__scroll {
  position: absolute;
  bottom: 36px;
  right: 6%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

@media (max-width: 768px) {
  .blog-detail-hero__scroll { display: none; }
}

.scroll-line {
  display: block;
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.18), transparent);
  animation: scrollLineAnim 2s ease-in-out infinite;
}

@keyframes scrollLineAnim {
  0% { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

.scroll-label {
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.28);
  writing-mode: vertical-rl;
  font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════ */
/* CANVAS PRINCIPAL — FONDO BLANCO, CONTENIDO MÁS ANCHO           */
/* ═══════════════════════════════════════════════════════════════ */
.detail-canvas {
  max-width: 1700px;
  margin: 0 auto;
  padding: 64px 6% 100px;
  display: grid;
  grid-template-columns: 56px 1fr 300px;
  gap: 48px;
  background: #ffffff;
}

@media (max-width: 1200px) {
  .detail-canvas {
    grid-template-columns: 48px 1fr 280px;
    gap: 36px;
    padding: 56px 5% 80px;
  }
}

@media (max-width: 1000px) {
  .detail-canvas {
    grid-template-columns: 48px 1fr;
    gap: 32px;
  }
  .detail-aside { display: none; }
}

@media (max-width: 768px) {
  .detail-canvas {
    grid-template-columns: 1fr;
    padding: 40px 5% 60px;
  }
  .detail-share { display: none; }
}

/* ══ SHARE COLUMN ═══════════════════════════════════════════════ */
.detail-share__sticky {
  position: sticky;
  top: 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
}

.detail-share__label {
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--ink-soft);
  writing-mode: vertical-rl;
}

.detail-share__rule {
  width: 1px;
  height: 48px;
  background: var(--rule);
}

.detail-share__btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--rule);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s var(--ease);
  color: var(--ink-soft);
}

.detail-share__btn:hover {
  background: var(--verdec);
  border-color: var(--verdec);
  color: #fff;
  transform: scale(1.08);
  box-shadow: 0 6px 20px rgba(71, 138, 61, 0.3);
}

