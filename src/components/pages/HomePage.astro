---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import { useTranslations, localePath } from "@i18n/index";
import type { Locale } from "@i18n/index";
import "@styles/components/home/homePage.css";
import { toursData } from "src/data/tours";
import { itinerariosData } from "src/data/itinerarios";
import { testimoniosData } from "src/data/testimonios";


interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const c = t.home.content ?? [];

const toursHome = toursData.slice(0, 3).map((tour) => {
  const itinerario = itinerariosData[tour.id];
  const durationDays = itinerario?.days.length ?? 0;
  const durationNights = durationDays > 0 ? durationDays - 1 : 0;
  return {
    ...tour,
    tag: t.recorridos.tagTranslations[tour.tagKey] || tour.tagKey,
    days: durationDays,
    nights: durationNights,
  };
});

const testimoniosList = testimoniosData.map((testimonio) => ({
  ...testimonio,
  rating: testimonio.rating ?? 5,
}));

const featureIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4" />
  </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
  </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
  </svg>`,
];
---

<BaseLayout fullscreen={true}>
  <Hero
    eyebrow={t.home.heroEyebrow}
    title={t.home.heroTitle}
    title2={t.home.heroTitle2}
    title3={t.home.heroTitle3}
    subtitle={t.home.heroSubtitle}
    cta={t.home.heroCta}
    ctaHref={localePath(lang, "/planificador")}
  />

  <!-- ══ ABOUT ══ -->
  <section class="section-about" >
    <div class="about-container" data-aos="fade-up"
     data-aos-duration="1000">
        <div class="about-header">
          <div class="container-sub">
            <img src={h.logo} alt="Logo" class="about-logo">
            <span style=" font-family: Montserrat, sans-serif;" class="eyebrow-title">{h.preTitle}</span>
            <div class="about-rule">
          </div>
          
        </div>
        <div class="container-title" style="width: 100%; display:flex; flex-direction: column;">
          <h2 class="about-title" style=" font-family: Montserrat, sans-serif;">{h.title}</h2>
          <h2 class="about-title" style="font-size: 40px; font-family: Montserrat, sans-serif; font-weight: 700;">{h.title2}</h2>
       </div>
      </div>
      <div class="about-content">
        <p class="about-text">{h.description}</p>
        <p class="about-text">{h.description2}</p>
        <p class="about-text ">{h.description3}</p>
      </div>

    
      <div class="about-action">
        <a href={localePath(lang, "/nosotros")} class="about-action__link">
          Descubra nuestra historia
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <div class="about-visual">
        <img style="box-shadow: rgba(0, 0, 0, 0.333) 10px 10px 20px 0px;" loading="lazy"  src="https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1788194432/v3_grtpb8.png" alt="Paisaje peruano" loading="lazy">
    </div>
  </section>


  <section class="workflow">
     <br><br><br>
  <div class="workflow-top">
    <div class="workflow-image">
      <img
        src="https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1788208661/84cda2e0-5dd4-482b-97e7-ae648a35eb20_cuiub5"
        alt="Encuentro con pobladores locales en los Andes peruanos"
        loading="lazy"
      />
    </div>

    <div class="workflow-text">
      <span class="eyebrow-title">Nuestra forma de trabajar</span>
      <div class="workflow-rule"></div>

      <h2 class="workflow-title">
        Más que conocer el Perú.
        <strong>Sabemos cómo hacerlo extraordinario.</strong>
      </h2>

      <div class="workflow-rule"></div>

      <p class="workflow-desc">
      Abrimos las puertas a un Perú auténtico, combinando experiencias únicas, conocimiento local y una operación impecable en cada detalle.
        <br />
        <br />
      Porque los grandes viajes no se recuerdan solo por los lugares que visitamos, sino por lo que sentimos, las historias que descubrimos y las personas que encontramos en el camino.
      </p>

    </div>
  </div>

  <div class="workflow-stats">
    <article class="stat-item">
      <h3 class="stat-title">Diseñamos cada viaje a medida</h3>
      <p class="stat-desc">
        Cada itinerario nace de entender al viajero. Diseñamos experiencias
        que responden a sus intereses, ritmo y expectativas.
      </p>
    </article>

    <article class="stat-item">
      <h3 class="stat-title">Conocemos el Perú de verdad</h3>
      <p class="stat-desc">
        Nuestros años en el destino nos permiten conocer rutas, tiempos,
        proveedores y experiencias que no siempre aparecen en los circuitos tradicionales.
      </p>
    </article>

    <article class="stat-item">
      <h3 class="stat-title">Operamos con experiencia y cuidado</h3>
      <p class="stat-desc">
        Nuestro equipo acompaña cada etapa del viaje, coordinando cada
        detalle para que nuestros socios y sus pasajeros puedan viajar con tranquilidad.
      </p>
    </article>
  </div>
  <br><br><br>
</section>

<style>
  .workflow {
    --gold: #c9962f;
    --green-dark: #12271b;
    --text-muted: #5a5a5a;
    background: #f4f3ef;
    font-family: "Montserrat", Helvetica, Arial, sans-serif;
  }

  .workflow-top {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    min-height: 660px;
  }

  .workflow-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px clamp(24px, 6vw, 96px);
  }

  .eyebrow-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .workflow-rule {
    width: 32px;
    height: 3px;
    background: var(--gold);
    margin: 18px 0;
  }

  .workflow-title {
    margin: 0;
    display:flex;
    flex-direction: column;

    font-family: "Montserrat", Helvetica, Arial, sans-serif;
    font-weight: 400;
    font-size: clamp(42px, 3.6vw, 47px);
    line-height: 1.10;
    color: var(--green-dark);
  }

  .workflow-title strong {
    font-weight: 700;
  }

  .workflow-title .dot {
    color: var(--gold);
    font-size: 70px;
  }

  .workflow-desc {
    max-width: 560px;
    margin: 26px 0 36px;
    color: black;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
  }

  .btn-workflow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    align-self: flex-start;
    padding: 17px 28px;
    background: var(--green-dark);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: gap 0.3s ease, background 0.3s ease;
  }

  .btn-workflow:hover {
    gap: 22px;
    background: #1c3826;
  }

  .workflow-image {
    position: relative;
    overflow: hidden;
  }

  .workflow-image img {
    width: 100%;
    height: 600px;
    object-fit: cover;
    display: block;
    padding-left: 150px;
  }

  .workflow-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1800px;
    margin: 0 auto;
    padding: 64px clamp(24px, 5vw, 60px);
  }

  .stat-item {
    text-align: center;
    padding: 0 32px;
    border-left: 1px solid rgba(0, 0, 0, 0.12);
  }

  .stat-item:first-child {
    border-left: none;
  }

  .stat-icon {
    width: 40px;
    height: 40px;
    margin: 0 auto 18px;
    color: var(--gold);
  }

  .stat-number {
    display: block;
    font-family: "Montserrat", Helvetica, Arial, sans-serif;
    font-size: 34px;
    font-weight: 400;
    color: var(--gold);
    margin-bottom: 18px;
  }

  .stat-title {
    margin: 0 0 14px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-dark);
  }

  .stat-desc {
    margin: 0 auto;
    max-width: 300px;
    color: black;
    font-size: 15.5px;
    font-weight: 300;
    line-height: 1.75;
  }
  @media (max-width: 1240px) {
      .workflow-image img {
    padding-left: 100px;
  }

  }

  @media (max-width: 900px) {
    .workflow-top {
      display: flex;
      flex-direction: column-reverse;
      min-height: auto;
    }

    .workflow-image {
      order: -1;
      min-height: 380px;
      border-radius: 0;

    }
.workflow-image img {
    padding-left: 0px;
  }
    .workflow-text {
      text-align: center;
      align-items: center;
    }

    .workflow-desc {
      margin-left: auto;
      margin-right: auto;
    }

    .btn-workflow {
      align-self: center;
    }
  }

  @media (max-width: 768px) {
    .workflow-stats {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .stat-item {
      border-left: none;
      border-top: 1px solid rgba(0, 0, 0, 0.12);
      padding: 32px 12px 0;
    }

    .stat-item:first-child {
      border-top: none;
      padding-top: 0;
    }
  }
</style>


