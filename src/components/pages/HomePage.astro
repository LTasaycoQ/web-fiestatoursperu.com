---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/sections/Hero.astro";
import { useTranslations, localePath } from "@i18n/index";
import type { Locale } from "@i18n/index";
import "@styles/components/home/homePage.css";
import { toursData } from "src/data/tours";
import { itinerariosData } from "src/data/itinerarios";
import { testimoniosData } from "src/data/testimonios";
import { Image } from "astro:assets";
import ApavitLogo from "@assets/logos-Respaldo/apavit.png";
import ApturLogo from "@assets/logos-Respaldo/Aptur.png";
import SiteLogo from "@assets/logos-Respaldo/SITE.png";
import TurismoCuscoLogo from "@assets/logos-Respaldo/tuRISMO-cUSCO.png";
import UstoaLogo from "@assets/logos-Respaldo/USTOA.png";
import PeruLuxury from "@assets/logos-Respaldo/peru-luxury-journeys.png";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.home;
const c = t.home.content ?? [];

const toursHome = toursData.slice(0, 3).map((tour) => {
  const itinerario = itinerariosData[tour.id];
  const durationDays = itinerario?.days.length ?? 0;
  const durationNights = durationDays > 0 ? durationDays - 1 : 0;
  return {
    ...tour,
    tag: t.recorridos.tagTranslations[tour.tagKey] || tour.tagKey,
    days: durationDays,
    nights: durationNights,
  };
});

const testimoniosList = testimoniosData.map((testimonio) => ({
  ...testimonio,
  rating: testimonio.rating ?? 5,
}));

const featureIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4" />
  </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
  </svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
  </svg>`,
];
---

<BaseLayout fullscreen={true}>
  <Hero
    eyebrow={t.home.heroEyebrow}
    title={t.home.heroTitle}
    title2={t.home.heroTitle2}
    title3={t.home.heroTitle3}
    subtitle={t.home.heroSubtitle}
    cta={t.home.heroCta}
    ctaHref={localePath(lang, "/planificador")}
  />

  <!-- ══ ABOUT ══ -->
  <section class="section-about">
    <div class="about-container">
      <div class="about-header" data-reveal="fade-up">
        <img src={h.logo} alt="Logo" class="about-logo">
        <span class="eyebrow-title">{h.preTitle}</span>
         <div class="about-rule"></div>
        <h2 class="about-title">{h.title}</h2>
       
      </div>
      <div class="about-content">
        <p class="about-text" data-reveal="fade-up" data-delay="100">{h.description}</p>
        <p class="about-text" data-reveal="fade-up" data-delay="200">{h.description2}</p>
        <p class="about-text " data-reveal="fade-up" data-delay="200">{h.description3}</p>
      </div>

      <div class="about-stats" data-reveal="fade-up" data-delay="210">
        <article class="about-stat">
          <svg
  xmlns="http://www.w3.org/2000/svg"
           class="about-stat__icon"

  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M18 21a8 8 0 0 0-16 0" />
  <path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3" />
  <circle cx="10" cy="8" r="5" />
    </svg>
              <strong class="about-stat__value">50</strong>
              <span class="about-stat__label">Años de trayectoria</span>
              <p>Desde 1976 creando experiencias inolvidables.</p>
            </article>

            <article class="about-stat">
              <svg
      xmlns="http://www.w3.org/2000/svg"
                class="about-stat__icon"

      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
      <circle cx="12" cy="10" r="3" />
    </svg>
          <strong class="about-stat__value">DMC</strong>
          <span class="about-stat__label">Especialistas en Perú</span>
          <p>Operación propia, conocimiento profundo y atención personalizada.</p>
        </article>

        <article class="about-stat">
          <svg
          xmlns="http://www.w3.org/2000/svg"
    
          class="about-stat__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 16c5 0 7-8 12-8a4 4 0 0 1 0 8c-5 0-7-8-12-8a4 4 0 1 0 0 8" />
        </svg>
          <strong class="about-stat__value">A medida</strong>
          <span class="about-stat__label">Viajes con propósito</span>
          <p>Diseñamos cada ruta con detalle, sensibilidad y estilo.</p>
        </article>
      </div>

      <div class="about-action" data-reveal="fade-up" data-delay="260">
        <a href={localePath(lang, "/nosotros")} class="about-action__link">
          Descubra nuestra historia
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    <div class="about-visual" data-reveal="fade-left">
      <img src="https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1787332976/pexels-janonovoa-16756568_gpa5gj.jpg" alt="Paisaje peruano" loading="lazy">
    </div>
  </section>

  <!-- ══ VALUE / FEATURES ══ -->
  <section class="section-value">
    <div class="value-container">
      <div class="value-image-col" data-reveal="fade-right">
        <div class="value-image-frame">
          <img
            src="https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1787342173/victor-rodriguez-IhAJpWUKS5s-unsplash_1_zdfbkd.jpg"
            alt="Paisaje de Cusco con montañas y arquitectura inca"
            loading="lazy"
            class="value-main-img"
          />
         
        </div>
      </div>

      <div class="value-content" data-reveal="fade-left">
        <h2 class="value-title">{h.infoTitle}</h2>
        <div class="value-features">
          {c.length > 0 && featureIcons.map((icon, i) => (
            <div class="value-feature" data-reveal="fade-up" data-delay={String((i + 1) * 100)}>
              <div class="feature-icon" >0{c[i]?.id} <span class="line_circle"></span> </div>
              <div class="feature-text">
                <h3 style="color: rgb(35, 47, 35);">{c[i]?.title}</h3>
                <p>{c[i]?.description}</p>
              </div>
            </div>
          ))}
        </div>
        <div  class="container-btn" style="margin-top: 20px; display:flex; align-items:center; justify-content: space-between;">
          <div class="value-button-wrapper" >
            <a href={localePath(lang, "/nosotros")} class="btn-value">
              {h.aboutBtn}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B48932" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 12l14 0" /><path d="M15 16l4 -4" /><path d="M15 8l4 4" /></svg>
            </a>
          </div>
          <span style="width: 1px; background: rgb(52, 65, 52); height: 100%;"></span>

          <div>
            <img style="width: 80px;" src="https://res.cloudinary.com/dlgeap8h0/image/upload/f_auto,q_auto/v1780341323/50-esp_jlhihh.png" alt="image_logo_50_anos" />
          </div>
          
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TOURS DESTACADOS ══ -->
  <section class="section-tours">
    <div class="tours-inner">
      <div class="tours-header" data-reveal="fade-up">
        <div class="tours-header-left">
          <span class="eyebrow-title">{h.toursEyebrow}</span>
          <h2 class="tours-title">
            {h.toursTitle}<br />
            <em>{h.toursTitle2}</em>
          </h2>
        </div>
        <a href={localePath(lang, "/itinerarios")} class="btn-outline-tours">
          {h.toursBtn}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="tours-grid">
        {toursHome.map((tour, i) => (
          <a
            href={localePath(lang, tour.link)}
            class={`tour-card tour-card--${i === 0 ? "featured" : "regular"}`}
            data-reveal="fade-up"
            data-delay={String(i * 150)}
          >
            <div class="tour-img-wrap">
              <img src={tour.image} alt={tour.title} loading="lazy" />
              <div class="tour-img-overlay" />
              <span class="tour-chip">{tour.tag}</span>
            </div>
            <div class="tour-body">
              <div class="tour-meta-row">
                {tour.days > 0 && (
                  <span class="tour-meta-pill">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    {tour.days}d / {tour.nights}n
                  </span>
                )}
                <span class="tour-meta-pill tour-meta-pill--loc">
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  Perú
                </span>
              </div>
              <h3 class="tour-name">{tour.title}</h3>
              <div class="tour-cta-row">
                <span class="tour-link-label">Ver itinerario</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ TESTIMONIOS CARRUSEL ══ -->
  <section class="testimonios">
    <div class="testimonios-header" data-reveal="fade-up">
      <span class="eyebrow-title">TESTIMONIOS</span>
      <h2 class="testimonios-title">
        Lo que dicen <em>nuestros viajeros</em>
      </h2>
      <div class="testimonios-rule"></div>
    </div>

    <div class="carousel-wrapper">
      <div class="carousel-container" id="testimoniosCarousel">
        <div class="carousel-track">
          {testimoniosList.map((testimonio) => (
            <div class="testimonial-card">
              <div class="testimonial-card__inner">
                <div class="testimonial-stars">
                  {(() => {
                    const stars = [];
                    for (let i = 0; i < 5; i++) {
                      stars.push(
                        <svg class="star-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill={i < testimonio.rating ? "#f5a623" : "#e0e0e0"}>
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                        </svg>
                      );
                    }
                    return stars;
                  })()}
                </div>
                <div class="testimonial-text">
                  <p>"{h.testimonialTexts?.[testimonio.textKey] ?? testimonio.textKey}"</p>
                </div>
                <div class="testimonial-author">
                  <div class="author-avatar">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                  <div class="author-info">
                    <h4>{testimonio.author}</h4>
                    <p>
                      {testimonio.roleKey
                        ? (h.roleTranslations?.[testimonio.roleKey] ?? testimonio.role)
                        : testimonio.role}
                      {testimonio.company !== "Unknown" ? ` · ${testimonio.company}` : ''}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button class="carousel-nav carousel-prev" aria-label="Anterior">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button class="carousel-nav carousel-next" aria-label="Siguiente">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div class="carousel-dots">
        {testimoniosList.map((_, index) => (
          <button class="carousel-dot" data-dot={index} aria-label={`Ir al testimonio ${index + 1}`}></button>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CTA FINAL ══ -->
  <section class="section-cta-final">
    <div class="cta-final-bg">
      <div class="cta-final-grain"></div>
    </div>
    <div class="cta-final-inner" data-reveal="fade-up">
      <span class="eyebrow-title eyebrow-title--light">¿Listo para viajar?</span>
      <h3 class="cta-final-title">Tu próxima aventura<br /><em>te está esperando</em></h3>
      <p class="cta-final-sub">Habla con nuestros asesores — 50 años de experiencia al servicio de tu viaje ideal</p>
      <div class="cta-final-actions">
        <a href="https://wa.link/xv7a9b" target="_blank" class="btn-cta-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.115.554 4.1 1.523 5.827L0 24l6.341-1.502A11.958 11.958 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.785 9.785 0 01-5.007-1.375l-.36-.214-3.727.883.936-3.619-.235-.372A9.783 9.783 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/>
          </svg>
          WhatsApp directo
        </a>
        <a href={localePath(lang, "/planificador")} class="btn-cta-secondary">
          Cotización personalizada
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="logos_socios" aria-labelledby="partners-title">
    <!-- <div class="logos_socios__header" data-reveal="fade-up">
      <span class="eyebrow-title">Confianza que nos respalda</span>
      <h2 id="partners-title">Socios y asociaciones</h2>
      <p>Formamos parte de una red que eleva los estándares del turismo en el Perú.</p>
    </div> -->

    <div class="logos_socios__grid" data-reveal="fade-up" data-delay="100">
      <div class="partner-logo"><img src={ApavitLogo.src} alt="APAVIT" loading="lazy" /></div>
      <div class="partner-logo"><img src={ApturLogo.src} alt="APTUR" loading="lazy" /></div>
      <div class="partner-logo"><img src={SiteLogo.src} alt="SITE" loading="lazy" /></div>
      <div class="partner-logo"><img src={TurismoCuscoLogo.src} alt="Turismo Cusco" loading="lazy" /></div>
      <div class="partner-logo"><img src={UstoaLogo.src} alt="USTOA" loading="lazy" /></div>
      <div class="partner-logo"><img src={PeruLuxury.src} alt="USTOA" loading="lazy" /></div>
    </div>
  </section>
</BaseLayout>

<script>
  let currentSlide = 0;
  let autoPlayTimer: ReturnType<typeof setInterval> | null = null;
  let isAnimating = false;
  let totalSlides = 0;
  let slidesPerView = 1;

  function getSlidesPerView(): number {
    const w = window.innerWidth;
    if (w >= 1024) return 3;
    if (w >= 768) return 2;
    return 1;
  }

  function getTrack(): HTMLElement | null {
    return document.querySelector<HTMLElement>('.carousel-track');
  }

  function updateCardWidths(): void {
    slidesPerView = getSlidesPerView();
    const pct = 100 / slidesPerView;
    document.querySelectorAll<HTMLElement>('.testimonial-card').forEach(card => {
      card.style.flex = `0 0 ${pct}%`;
      card.style.maxWidth = `${pct}%`;
      card.style.minWidth = `${pct}%`;
    });
  }

  function goToSlide(index: number, animate = true): void {
    const track = getTrack();
    if (!track) return;
    if (index < 0) index = 0;
    if (index >= totalSlides) index = totalSlides - 1;
    currentSlide = index;
    const pct = 100 / slidesPerView;
    if (!animate) {
      track.style.transition = 'none';
      track.style.transform = `translateX(${-(currentSlide * pct)}%)`;
      track.getBoundingClientRect(); // forzar reflow Safari
    } else {
      track.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
      track.style.transform = `translateX(${-(currentSlide * pct)}%)`;
    }
    updateDots();
  }

  function nextSlide(): void {
    if (isAnimating) return;
    isAnimating = true;
    goToSlide(currentSlide + 1 >= totalSlides ? 0 : currentSlide + 1, true);
    setTimeout(() => { isAnimating = false; }, 520);
  }

  function prevSlide(): void {
    if (isAnimating) return;
    isAnimating = true;
    goToSlide(currentSlide - 1 < 0 ? totalSlides - 1 : currentSlide - 1, true);
    setTimeout(() => { isAnimating = false; }, 520);
  }

  function updateDots(): void {
    document.querySelectorAll('.carousel-dot').forEach((dot, idx) => {
      dot.classList.toggle('active', idx === currentSlide);
    });
  }

  function startAutoPlay(): void {
    stopAutoPlay();
    autoPlayTimer = setInterval(() => {
      if (!isAnimating) nextSlide();
    }, 5000);
  }

  function stopAutoPlay(): void {
    if (autoPlayTimer !== null) {
      clearInterval(autoPlayTimer);
      autoPlayTimer = null;
    }
  }

  function applyTouchStyles(el: HTMLElement): void {
    el.style.touchAction = 'manipulation';
    el.style.cursor = 'pointer';
    el.setAttribute(
      'style',
      el.getAttribute('style') + '; -webkit-tap-highlight-color: transparent; -webkit-user-select: none; user-select: none;'
    );
  }

  function addNavListener(btn: HTMLElement, action: () => void): void {
    btn.style.minWidth = '44px';
    btn.style.minHeight = '44px';
    btn.style.position = 'absolute';
    btn.style.zIndex = '20';
    applyTouchStyles(btn);

    let didMove = false;

    btn.addEventListener('touchstart', () => {
      didMove = false;
    }, { passive: true });

    btn.addEventListener('touchmove', () => {
      didMove = true;
    }, { passive: true });

    btn.addEventListener('touchend', (e) => {
      if (didMove) return;
      e.preventDefault();
      action();
      startAutoPlay();
    }, { passive: false });

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      action();
      startAutoPlay();
    });
  }

  function initTilt(): void {
    if ('ontouchstart' in window) return;
    document.querySelectorAll<HTMLElement>('.tour-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `perspective(1000px) rotateY(${x * 6}deg) rotateX(${-y * 4}deg) translateY(-6px)`;
      });
      card.addEventListener('mouseleave', () => { card.style.transform = ''; });
    });
  }

  function initCarousel(): void {
    const cards = document.querySelectorAll<HTMLElement>('.testimonial-card');
    if (!cards.length) return;

    totalSlides = cards.length;
    updateCardWidths();
    goToSlide(0, false);

    const prevBtn = document.querySelector<HTMLElement>('.carousel-prev');
    const nextBtn = document.querySelector<HTMLElement>('.carousel-next');
    if (prevBtn) addNavListener(prevBtn, prevSlide);
    if (nextBtn) addNavListener(nextBtn, nextSlide);

    document.querySelectorAll<HTMLElement>('.carousel-dot').forEach((dot, idx) => {
      applyTouchStyles(dot);

      let dotMoved = false;

      dot.addEventListener('touchstart', () => { dotMoved = false; }, { passive: true });
      dot.addEventListener('touchmove', () => { dotMoved = true; }, { passive: true });
      dot.addEventListener('touchend', (e) => {
        if (dotMoved) return;
        e.preventDefault();
        if (!isAnimating && idx !== currentSlide) {
          isAnimating = true;
          goToSlide(idx, true);
          startAutoPlay();
          setTimeout(() => { isAnimating = false; }, 520);
        }
      }, { passive: false });
      dot.addEventListener('click', () => {
        if (!isAnimating && idx !== currentSlide) {
          isAnimating = true;
          goToSlide(idx, true);
          startAutoPlay();
          setTimeout(() => { isAnimating = false; }, 520);
        }
      });
    });

    const container = document.querySelector<HTMLElement>('.carousel-container');
    if (container) {
      let touchStartX = 0;
      let touchStartY = 0;
      let isSwiping = false;

      container.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isSwiping = false;
        stopAutoPlay();
      }, { passive: true });

      container.addEventListener('touchmove', (e) => {
        const dx = Math.abs(e.touches[0].clientX - touchStartX);
        const dy = Math.abs(e.touches[0].clientY - touchStartY);
        if (dx > dy && dx > 10) isSwiping = true;
      }, { passive: true });

      container.addEventListener('touchend', (e) => {
        if (!isSwiping) { startAutoPlay(); return; }
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) {
          dx < 0 ? nextSlide() : prevSlide();
        }
        startAutoPlay();
      }, { passive: true });

      container.addEventListener('mouseenter', stopAutoPlay);
      container.addEventListener('mouseleave', startAutoPlay);
    }

    let resizeTimer: ReturnType<typeof setTimeout>;
    const onResize = () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateCardWidths();
        goToSlide(currentSlide, false);
      }, 200);
    };
    window.addEventListener('resize', onResize, { passive: true });
    window.addEventListener('orientationchange', () => {
      setTimeout(onResize, 300);
    }, { passive: true });

    startAutoPlay();
  }

  // Punto de entrada único: esperar a que todo esté cargado
  document.body.style.overflowX = 'hidden';
  document.documentElement.style.overflowX = 'hidden';

  window.addEventListener('load', () => {
    initCarousel();
    initTilt();
  }, { once: true });
</script>