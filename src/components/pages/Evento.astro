<style>
  .scenarios-section {
    background: #f1f1f1;
  }

  .scenarios-section__inner {
    display: grid;
    grid-template-columns: minmax(320px, 0.75fr) minmax(0, 1.25fr);
    width: 100%;
  }

  .scenarios-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px 48px;
    background: #0E251B;
    color: #fff;
  }

  .scenarios-copy__eyebrow {
    margin: 0 0 24px;
    color: #d8bd77;
    font-family: var(--font-aktiv);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    font-style: normal;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .scenarios-copy__rule {
    width: 56px;
    height: 2px;
    margin-bottom: 24px;
    background: #b08c3a;
  }

  .scenarios-copy h2 {
    margin: 0 0 20px;
    font-family: var(--font-ppnue);
    font-size: 42px;
    font-weight: 500;
    line-height: 1.15;
  }

  .scenarios-copy > p:last-child {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-ppnue);
    font-size: 16px;
    line-height: 1.75;
  }

  .scenarios-copy__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    align-self: flex-start;
    margin-top: 30px;
    padding: 12px 15px;
    border: 1px solid rgba(255, 255, 255, 0.48);
    color: #fff;
    font-family: var(--font-aktiv);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .scenarios-copy__link:hover {
    border-color: #b08c3a;
    background: #b08c3a;
  }

  .scenarios-copy__link svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .scenarios-grid {
    display: grid;
    gap: 5px;
    background-color:white;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 0;
  }

  .scenarios-grid__item {
    position: relative;
    min-height: 390px;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #253020;
  }

  .scenarios-grid__item::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.72) 100%);
    content: "";
  }

  .scenarios-grid__item img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .scenarios-grid__item:hover img {
    transform: scale(1.04);
  }

  .scenarios-grid__item figcaption {
    position: absolute;
    z-index: 1;
    right: 14px;
    bottom: 18px;
    left: 14px;
    color: #fff;
    font-family: var(--font-ppnue);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .scenarios-section__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .scenarios-copy {
      padding: 44px 32px;
    }

    .scenarios-grid__item {
      min-height: 320px;
    }
  }

  @media (max-width: 600px) {
    .scenarios-copy {
      padding: 36px 24px;
    }

    .scenarios-copy h2 {
      font-size: 34px;
    }

    .scenarios-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .scenarios-grid__item {
      min-height: 250px;
    }

    .scenarios-grid__item figcaption { font-size: 11px; }
  }

  .inc-cta {
    position: relative;
    overflow: hidden;
    background-color:#F1F1F1;
    display: flex;
    align-items: center;
  }

  .inc-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: 0;
  }

  .inc-cta__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.634);
  }

  .inc-cta__inner {
    position: relative;
    height: 500px;
    width: 100%;
    margin: 0 auto;
  }
</style>


</BaseLayout>

<style is:global>

:root {
  --color-verde:       #2d5a27;
  --color-verdec:      #3a7a32;
  --color-verde-claro: #4a9a3f;
  --color-verde-subtle: rgba(45, 90, 39, 0.12);
  --color-verde-border: rgba(45, 90, 39, 0.16);
  --color-red:         #B8231E;
  --color-red-dark:    #8f1a16;
  --color-dark:        #1a1a1a;
  --color-darker:      #0a0c0a;
  --color-navy:        #1c1e2a;
  --color-cream:       #ffffff;
  --color-off-white:   #faf9f8;
  --color-text-muted:  rgba(255, 255, 255, 0.65);
  --color-ink:         #181c17;
  --color-muted:       #6b7068;

  --font-display: 'Cormorant Garamond', Georgia, serif;
  --font-body:    'DM Sans', system-ui, sans-serif;

  --nav-height:   72px;
  --section-px:   8%;

  /* Bordes */
  --radius-sm: 2px;
  --radius-md: 4px;
  --radius-lg: 8px;

  /* Transiciones */
  --transition-fast: 0.22s ease;
  --transition-mid:  0.35s ease;
}

/* ── RESET ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 18px;
}

body {
  font-family: var(--font-ppnue);
  background: var(--color-darker);
  color: #fff;
  overflow-x: hidden;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img, video { display: block; max-width: 100%; }
a { text-decoration: none; }
button { cursor: pointer; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar       { width: 5px; }
::-webkit-scrollbar-track { background: var(--color-darker); }
::-webkit-scrollbar-thumb { background: var(--color-verde); border-radius: 3px; }

/* ── UTILIDADES TIPOGRÁFICAS ── */
.eyebrow {
  font-family: var(--font-ppnue);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.40em;
  text-transform: uppercase;
  color: white;
  display: block;
}

.display-title {
  font-weight: 300;
  line-height: 1.08;
  letter-spacing: -0.02em;
}

.verde-rule {
  width: 56px;
  height: 2px;
  background: var(--color-verde);
  display: block;
  margin: 24px 0;
}

/* ── LAYOUT BASE ── */
.page-wrapper {
  padding-top: var(--nav-height);
}

/* ── HERO INTERNO ── */
.inner-hero {
  position: relative;
  height: 65vh;
  min-height: 420px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-top: -45px;
}

.inner-hero__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
}

.inner-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.3) 0%,
    rgba(0,0,0,0.6) 100%
  );
}

.inner-hero__title {
  position: relative;
  z-index: 2;
  font-family: var(--font-playfair);
  font-size: clamp(38px, 5.5vw, 66px);
  font-weight: 300;
  color: #fff;
  text-align: center;
  text-shadow: 0 2px 32px rgba(0,0,0,0.45);
  letter-spacing: -0.02em;
}

/* ── SECCIÓN DE CONTENIDO ── */
.content-section {
  background: var(--color-off-white);
  color: var(--color-ink);
  padding: 100px var(--section-px);
}

.section-body {
  font-size: 16px;
  font-weight: 300;
  line-height: 2;
  color: #525252;
  max-width: 680px;
  letter-spacing: 0.01em;
}

/* ── CARDS GRID ── */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 28px;
  margin-top: 56px;
}

.card {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.07);
  transition: transform var(--transition-mid), box-shadow var(--transition-mid);
}
.card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.13);
}
.card__img { width: 100%; height: 220px; object-fit: cover; }
.card__body { padding: 28px; }
.card__tag {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-verde);
  margin-bottom: 10px;
  display: block;
}
.card__title {
  font-family: var(--font-ppnue);
  font-size: 26px;
  font-weight: 400;
  color: var(--color-darker);
  margin-bottom: 12px;
  line-height: 1.2;
}
.card__desc {
  font-size: 14px;
  color: #666;
  line-height: 1.85;
  font-weight: 300;
}

/* ── BOTÓN PRIMARIO ── */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 38px;
  background: var(--color-verdec);
  color: #fff;
  font-family: var(--font-ppnue);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  border: none;
  border-radius: var(--radius-sm);
  transition: background var(--transition-fast), transform 0.2s ease;
  cursor: pointer;
  text-decoration: none;
}
.btn-primary:hover {
  background: var(--color-verde);
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(58, 122, 50, 0.32);
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 14px 34px;
  border: 1px solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.72);
  font-family: var(--font-ppnue);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  border-radius: var(--radius-sm, 4px);
  text-decoration: none;
  transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
}
.btn-ghost:hover {
  border-color: rgba(255,255,255,0.5);
  color: #fff;
  background: rgba(255,255,255,0.05);
}

/* ── FOOTER ── */
.site-footer {
  background: var(--color-darker);
  padding: 72px var(--section-px) 32px;
  color: rgba(255,255,255,0.5);
}
.footer__grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
}
.footer__col h4 {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--color-verdec);
  margin-bottom: 20px;
}
.footer__col a {
  display: block;
  font-size: 14px;
  font-weight: 300;
  color: rgba(255,255,255,0.45);
  margin-bottom: 12px;
  transition: color var(--transition-fast);
}
