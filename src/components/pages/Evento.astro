---
// src/components/pages/Evento.astro
import { localePath } from "@i18n";

import BaseLayout from "@layouts/BaseLayout.astro";
import { useTranslations } from "@i18n/index";
import type { Locale } from "@i18n/index";
import "@styles/components/itinerario/itinerariosPage.css";
import { incentivosExperiences } from "src/data/incentivos";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const i = useTranslations(lang).incentivos;

const escenarios = [
  { label: i.miceScenarioLabels?.[0] ?? "", image: incentivosExperiences[0].img },
  { label: i.miceScenarioLabels?.[1] ?? "", image: incentivosExperiences[1].img },
  { label: i.miceScenarioLabels?.[2] ?? "", image: incentivosExperiences[2].img },
  { label: i.miceScenarioLabels?.[3] ?? "", image: incentivosExperiences[3].img },
];


---

<BaseLayout fullscreen={true} title={i.miceMetaTitle} description={i.miceMetaDescription}>

  <section class="blog-hero">
    <div class="blog-hero__bg">
      <img style="transform: scaleX(-1);"
        src="https://res.cloudinary.com/dlgeap8h0/image/upload/v1781105098/iStock-2210631585_ef4mer.jpg"
        alt="Amazon river cruise landscape"
        aria-hidden="true"
        fetchpriority="high"
      />
    </div>
    <div class="blog-hero__overlay"></div>

    <div class="blog-hero__content" style="  font-family: var(--font-aktiv);
"  data-aos="fade-right">
      <p class="hero-eyebrow">{i.miceHeroEyebrow}</p>
      <div class="hero-rule"></div>
      <h1 class="blog-hero__title" style="font-family: var(--font-playfair); font-weight: 500; font-style: normal;">{i.miceHeroTitle}</h1>
      <p style="font-family: var(--font-aktiv) font-weight: 400; font-style: normal; font-size: 24px;">{i.miceHeroSubtitle}</p>
      <div class="hero-rule"></div>
      <p class="blog-hero__sub" style="font-family: var(--font-aktiv) font-weight: 400; font-style: normal;">{i.miceHeroDescription}</p>
    
        
    </div>

    <!-- <div class="blog-hero__scroll" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="scroll-label">Experiencias que <br> dejan huella</span>
    </div> -->
  </section>



    <section class="trust-bar" style="background-color: #F1F1F1;">
    <div class="trust-bar__inner"  data-aos="fade-up">
      <div class="trust-bar__item" style="height: 270px; min-width: 250px; padding: 20px; border-radius: 8px; display:flex; flex-direction:column; align-items:center; justify-content:center; justify-content:start; align-items:center;  font-family: var(--font-aktiv);">
