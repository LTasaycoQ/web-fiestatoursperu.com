/* ═══════════════════════════════════════════════════════════════ */
/* iOS SAFARI FIX                                                 */
/* ═══════════════════════════════════════════════════════════════ */
@supports (-webkit-touch-callout: none) {
  .blog-hero {
    min-height: -webkit-fill-available !important;
  }
  .blog-hero__bg,
  .blog-hero__overlay {
    position: absolute !important;
    height: 100% !important;
  }
  .blog-hero__bg img {
    height: 100% !important;
    object-fit: cover !important;
  }
}

[hidden] { display: none !important; }
</style>

<script>
  (function() {
    // Type-safe view mode handler
    type ViewMode = 'grid' | 'list';
    
    function init() {
      // ========== VIEW TOGGLE with proper typing ==========
      const btnList = document.getElementById("btn-list") as HTMLButtonElement | null;
      const btnDashboard = document.getElementById("btn-dashboard") as HTMLButtonElement | null;
      const container = document.getElementById("posts-container") as HTMLDivElement | null;

      function setView(mode: ViewMode): void {
        if (!container) return;
        if (mode === "list") {
          container.classList.remove("grid-mode");
          container.classList.add("list-mode");
          btnList?.classList.add("view-btn--active");
          btnDashboard?.classList.remove("view-btn--active");
        } else {
          container.classList.remove("list-mode");
          container.classList.add("grid-mode");
          btnDashboard?.classList.add("view-btn--active");
          btnList?.classList.remove("view-btn--active");
        }
      }

      if (btnDashboard) btnDashboard.addEventListener("click", () => setView("grid"));
      if (btnList) btnList.addEventListener("click", () => setView("list"));

      // ========== CATEGORY FILTER ==========
      const filterBtns = document.querySelectorAll(".filter-btn");
      const allCards = document.querySelectorAll<HTMLElement>(".post-card");

      function filterPosts(category: string): void {
        allCards.forEach((card) => {
          const cardCategory = card.getAttribute("data-category");
          if (category === "All" || cardCategory === category) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach(b => b.classList.remove("filter-btn--active"));
          btn.classList.add("filter-btn--active");
          
          const category = btn.getAttribute("data-category") || "All";
          filterPosts(category);
        });
      });

      // ========== NEWSLETTER ==========
      const form = document.getElementById("nl-form") as HTMLFormElement | null;
      const successMsg = document.getElementById("nl-success");
      const submitBtn = document.getElementById("nl-submit") as HTMLButtonElement | null;

      if (form) {
        form.addEventListener("submit", (e: Event) => {
          e.preventDefault();
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }
          if (submitBtn) submitBtn.disabled = true;
          
          setTimeout(() => {
            form.reset();
            if (successMsg) successMsg.hidden = false;
            setTimeout(() => {
              if (successMsg) successMsg.hidden = true;
              if (submitBtn) submitBtn.disabled = false;
            }, 3500);
          }, 700);
        });
      }

      // ========== LOAD MORE ==========
      const loadMoreBtn = document.getElementById("load-more") as HTMLButtonElement | null;
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener("click", function(this: HTMLButtonElement) {
          this.style.opacity = "0.7";
          this.style.pointerEvents = "none";
          setTimeout(() => {
            this.style.opacity = "1";
            this.style.pointerEvents = "auto";
            alert("More stories coming soon!");
          }, 500);
        });
      }
    }

    // Initialize when DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>