---
// src/components/pages/Evento.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import { localePath } from "@i18n/index";
import type { Locale } from "@i18n/index";
import "@styles/components/itinerario/itinerariosPage.css";
import { incentivosExperiences } from "src/data/incentivos";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const ui = {
  metaTitle: "Amazon Journal — Stories from the River",
  metaDesc: "Dispatches, guides and nature notes from deep inside the Peruvian Amazon.",
  heroEyebrow: "Amazon Journal",
  heroTitle: "Stories from\nthe River",
  heroSubtitle: "Field notes, travel guides and wonder from deep inside the Peruvian Amazon.",
  readLabel: "min read",
  readMore: "Read story",
  loadMore: "Load more stories",
  catAll: "All",
  catNature: "Nature & Wildlife",
  catTravel: "Travel & Culture",
  catGuide: "Travel Guide",
  catSustain: "Sustainability",
  catCulture: "Culture & Food",
  nlEyebrow: "Stay in the story",
  nlTitle: "Dispatches from the Amazon, delivered to your inbox.",
  nlBody: "Field notes, seasonal guides and exclusive voyage offers — no more than twice a month.",
  nlName: "Your name",
  nlEmail: "Email address",
  nlBtn: "Subscribe",
  nlPrivacy: "No spam, ever. Unsubscribe at any time.",
  nlSuccess: "Thank you! Watch your inbox for the first dispatch.",
  ctaEyebrow: "Ready for the river?",
  ctaTitle: "Turn these stories into your own.",
  ctaBtn1: "Explore our cruises",
  ctaBtn2: "Talk to an expert",
};

const escenarios = [
  { label: "Locaciones históricas", image: incentivosExperiences[0].img },
  { label: "Espacios exclusivos", image: incentivosExperiences[1].img },
  { label: "Experiencias únicas", image: incentivosExperiences[2].img },
  { label: "Incentivos en la naturaleza", image: incentivosExperiences[3].img },
];


---

<BaseLayout fullscreen={true} title={ui.metaTitle} description={ui.metaDesc}>

  <section class="blog-hero">
    <div class="blog-hero__bg">
      <img style="transform: scaleX(-1);"
        src="https://res.cloudinary.com/dlgeap8h0/image/upload/v1781105098/iStock-2210631585_ef4mer.jpg"
        alt="Amazon river cruise landscape"
        aria-hidden="true"
        fetchpriority="high"
      />
    </div>
    <div class="blog-hero__overlay"></div>

    <div class="blog-hero__content"  data-aos="fade-right">
      <p class="hero-eyebrow">Reuniones . Incentivos . Congresos . Eventos</p>
      <div class="hero-rule"></div>
      <h1 class="blog-hero__title">MICE</h1>
      <p style="font-size: 24px; font-weight: 100;">Donde los negocios se convierten en experiencias</p>
      <div class="hero-rule"></div>
      <p class="blog-hero__sub">Diseñamos y operamos experiencias corporativas en Perú, combinando conocimiento local, excelencia operativa y creatividad para entregar eventos que inspiran, conectan y generan un impacto duradero.</p>
    
        
    </div>

    <div class="blog-hero__scroll" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="scroll-label">Experiencias que <br> dejan huella</span>
    </div>
  </section>



    <section class="trust-bar" style="background-color: #F1F1F1;">
    <div class="trust-bar__inner"  data-aos="fade-up">
      <div class="trust-bar__item" style="min-width: 250px; padding: 20px; border-radius: 8px; display:flex; flex-direction:column; align-items:center; justify-content:center; justify-content:start; align-items:center;">
       <svg width="50px" height="50px" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <rect width="48" height="48" fill="white" fill-opacity="0.01"></rect> <path d="M24 20C27.866 20 31 16.866 31 13C31 9.13401 27.866 6 24 6C20.134 6 17 9.13401 17 13C17 16.866 20.134 20 24 20Z" fill="" stroke="#B08C3A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M12 7.25468C10.1865 8.51963 9 10.6212 9 13C9 15.5463 10.3596 17.7751 12.3924 19" stroke="#B08C3A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M36 7.25468C37.8135 8.51963 39 10.6212 39 13C39 15.3787 37.8135 17.4804 36 18.7453" stroke="#B08C3A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M12 40V42H36V40C36 36.2725 36 34.4087 35.391 32.9385C34.5791 30.9783 33.0217 29.4209 31.0615 28.609C29.5913 28 27.7275 28 24 28C20.2725 28 18.4087 28 16.9385 28.609C14.9783 29.4209 13.4209 30.9783 12.609 32.9385C12 34.4087 12 36.2725 12 40Z" fill="" stroke="#B08C3A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M43.9999 42V40.8C43.9999 36.3196 43.9999 34.0794 43.128 32.3681C42.361 30.8628 41.1371 29.6389 39.6318 28.8719" stroke="#B08C3A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M4.00009 42V40.8C4.00009 36.3196 4.00009 34.0794 4.87204 32.3681C5.63902 30.8628 6.86287 29.6389 8.36816 28.8719" stroke="#B08C3A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
        <strong style="font-weight: 700;">REUNIONES</strong>
        <span style="font-size: 17px;">Reuniones y encuentros corporativos diseñados alrededor de los objetivos de caada organizacion</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item" style="min-width: 250px; padding: 20px; border-radius: 8px;">
       <svg class="trofeo" width="50px" height="50px" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" style="enable-background:new 0 0 1024 1024" xml:space="preserve" fill="#000000" stroke="#000000" stroke-width="10.24"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M918.4 201.6c-6.4-6.4-12.8-9.6-22.4-9.6H768V96c0-9.6-3.2-16-9.6-22.4C752 67.2 745.6 64 736 64H288c-9.6 0-16 3.2-22.4 9.6C259.2 80 256 86.4 256 96v96H128c-9.6 0-16 3.2-22.4 9.6-6.4 6.4-9.6 16-9.6 22.4 3.2 108.8 25.6 185.6 64 224 34.4 34.4 77.56 55.65 127.65 61.99 10.91 20.44 24.78 39.25 41.95 56.41 40.86 40.86 91 65.47 150.4 71.9V768h-96c-9.6 0-16 3.2-22.4 9.6-6.4 6.4-9.6 12.8-9.6 22.4s3.2 16 9.6 22.4c6.4 6.4 12.8 9.6 22.4 9.6h256c9.6 0 16-3.2 22.4-9.6 6.4-6.4 9.6-12.8 9.6-22.4s-3.2-16-9.6-22.4c-6.4-6.4-12.8-9.6-22.4-9.6h-96V637.26c59.4-7.71 109.54-30.01 150.4-70.86 17.2-17.2 31.51-36.06 42.81-56.55 48.93-6.51 90.02-27.7 126.79-61.85 38.4-38.4 60.8-112 64-224 0-6.4-3.2-16-9.6-22.4zM256 438.4c-19.2-6.4-35.2-19.2-51.2-35.2-22.4-22.4-35.2-70.4-41.6-147.2H256v182.4zm390.4 80C608 553.6 566.4 576 512 576s-99.2-19.2-134.4-57.6C342.4 480 320 438.4 320 384V128h384v256c0 54.4-19.2 99.2-57.6 134.4zm172.8-115.2c-16 16-32 25.6-51.2 35.2V256h92.8c-6.4 76.8-19.2 124.8-41.6 147.2zM768 896H256c-9.6 0-16 3.2-22.4 9.6-6.4 6.4-9.6 12.8-9.6 22.4s3.2 16 9.6 22.4c6.4 6.4 12.8 9.6 22.4 9.6h512c9.6 0 16-3.2 22.4-9.6 6.4-6.4 9.6-12.8 9.6-22.4s-3.2-16-9.6-22.4c-6.4-6.4-12.8-9.6-22.4-9.6z" fill="#000000"></path></g></svg>
        <strong style="font-weight: 700;">INCENTIVOS</strong>
         <span style="font-size: 17px;">Experiencias memorables que reconocen, motivan y conectan a los equipos</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item" style="min-width: 250px; padding: 20px; border-radius: 8px;">
       <svg class="pizarra" version="1.1" id="Icons" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 32 32" xml:space="preserve" width="50px" height="50px" fill="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <style type="text/css"> .st0{fill:none;stroke:#000000;stroke-width:1.8559999999999999;stroke-linecap:round;stroke-linejoin:round;stroke-miterlimit:10;} .st1{fill:none;stroke:#000000;stroke-width:1.8559999999999999;stroke-linecap:round;stroke-linejoin:round;} .st2{fill:none;stroke:#000000;stroke-width:1.8559999999999999;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:5.2066,0;} </style> <rect x="4" y="4" class="st0" width="24" height="17"></rect> <polyline class="st0" points="16,28 16,21 9,29 "></polyline> <line class="st0" x1="23" y1="29" x2="16" y2="21"></line> <line class="st0" x1="2" y1="4" x2="30" y2="4"></line> <polyline class="st0" points="8,16 12,12 16,12 20,14 24,8 "></polyline> </g></svg>
        <strong style="font-weight: 700;">CONGRESOS</strong>
         <span style="font-size: 17px;">Operacion integral para congresos, conveciones y grupos profesionales</span>
      </div>
      <div class="trust-bar__divider"></div>
      <div class="trust-bar__item" style="min-width: 250px; padding: 20px; border-radius: 8px;">
        <svg class="copa" fill="#000000" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="50px" height="50px" viewBox="0 0 45.812 45.812" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <path d="M41.493,41.12c-0.25-1.295-3.41-1.802-7.339-1.269l-1.276-6.594c2.324-1.097,3.806-3.596,3.52-6.244l-1.791-16.505 c-0.103-0.942-0.598-1.806-1.361-2.37c-0.753-0.556-1.735-0.783-2.665-0.602L25.65,8.49c-0.089-0.302-0.218-0.593-0.389-0.864 c-0.507-0.8-1.332-1.357-2.263-1.527l-8.125-1.484c-0.939-0.172-1.909,0.066-2.658,0.63c-0.756,0.571-1.244,1.438-1.336,2.383 L9.265,24.152c-0.26,2.652,1.249,5.131,3.586,6.199l-1.208,6.615c-3.935-0.49-7.088,0.049-7.325,1.346 c-0.266,1.457,3.245,3.318,7.842,4.158c4.597,0.84,8.54,0.34,8.806-1.117c0.237-1.299-2.522-2.918-6.376-3.85l1.209-6.621 c2.608-0.168,4.855-1.98,5.545-4.533l1.057-3.912l1.944,6.908c0.714,2.539,2.986,4.342,5.596,4.482l1.274,6.591 c-3.844,0.972-6.586,2.62-6.335,3.915c0.281,1.454,4.229,1.914,8.817,1.025C38.283,44.473,41.774,42.573,41.493,41.12z M19.905,20.195l-7.324,0.809L13.86,7.921c0.011-0.113,0.069-0.216,0.159-0.284c0.064-0.048,0.141-0.077,0.274-0.077 c0.014,0,0.028,0,0.043,0.001l8.125,1.484c0.041,0.007,0.079,0.021,0.115,0.04l-0.104,0.021c-0.932,0.18-1.751,0.746-2.249,1.553 c-0.498,0.808-0.636,1.793-0.379,2.706l0.972,3.453L19.905,20.195z M22.728,12.551c-0.031-0.108-0.014-0.225,0.045-0.321 c0.059-0.097,0.156-0.164,0.268-0.185l8.186-1.577c0.087,0,0.172,0.028,0.239,0.078c0.091,0.068,0.151,0.171,0.163,0.283 l1.418,13.069l-7.332-0.731L22.728,12.551z"></path> <circle cx="17.599" cy="17.104" r="1.451"></circle> <circle cx="16.871" cy="10.999" r="1.157"></circle> <circle cx="21.434" cy="3.337" r="1.311"></circle> <circle cx="25.944" cy="1.311" r="1.311"></circle> <circle cx="26.841" cy="5.883" r="1.235"></circle> <circle cx="26.229" cy="15.535" r="1.283"></circle> <circle cx="29.566" cy="20.916" r="1.49"></circle> </g> </g> </g></svg>
        <strong  style="font-weight: 700;">EVENTOS ESPECIALES</strong>
         <span style="font-size: 17px;">Eventos únicos que combinan produccion, logistica y escenarios extraordinarios en todo el Perú</span>
      </div>
    </div>
  </section>




  <div style="background-color: #0D2519; width: 100%;">
  <section class="scenarios-section" style="background-color: #0D2519; width: 100%;">
    <div class="scenarios-section__inner">
      <div class="scenarios-copy">
        <p class="scenarios-copy__eyebrow">Escenarios únicos<br />para ideas extraordinarias</p>
        <span class="scenarios-copy__rule" aria-hidden="true"></span>
        <h2>El Perú como escenario de grandes ideas</h2>
        <p>Desde ciudades históricas hasta paisajes inigualables, ofrecemos locaciones únicas y experiencias auténticas que transforman cualquier evento en algo inolvidable.</p>
        <a class="scenarios-copy__link" href={localePath(lang, "/destinos")}>
          Descubre nuestros destinos MICE
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="scenarios-grid">
        {escenarios.map((escenario) => (
          <figure class="scenarios-grid__item">
            <img src={escenario.image} alt={escenario.label} loading="lazy" />
            <figcaption>{escenario.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
    </div>


  <section class="inc-cta">
  <img 
    src="https://res.cloudinary.com/dlgeap8h0/image/upload/v1790288751/iStock-1454581645_uwxcap.jpg" 
    alt="" 
    class="inc-cta__bg"
    aria-hidden="true"
  />
    <div class="hero_overlay" style="background: linear-gradient(
    to left,
    rgba(0, 0, 0, 0.767) 20%,
    rgba(0, 0, 0, 0.582) 55%,
    rgba(0, 0, 0, 0.37) 80%
  ); position:absolute; inset: 0; z-index: -1 width: 100%; height: 100%;"></div>

  <div class="inc-cta__inner" style="display:flex; justify-content: end; align-items: center; max-width: 1400px;" data-aos="fade-up">
    <div style="display: flex; flex-direction: column; text-align: start;">

        <div>
        <p class="hero-eyebrow" style="font-size: 15px;">MÁS QUE UN EVENTO</p>

        <div class="hero-rule" style="margin-top: -20px;"></div>
        </div>
      <h2 class="inc-cta__title" style="font-family: var(--font-ppnue); font-weight: 500; font-size: 30px; line-height: 1.2;">Creamos conexiones que <br> que trascienden.</h2>
      <span style=" margin-top: 20px; font-size: 17px; font-family: var(--font-ppnue); width: 400px;">Eventos que inspiran personas. fortalecen relaciones y dejan un impacto positivo.</span>
    </div>
    
  </div>
</section>

<style>
  .scenarios-section {
    background: #f1f1f1;
  }

  .scenarios-section__inner {
    display: grid;
    grid-template-columns: minmax(320px, 0.75fr) minmax(0, 1.25fr);
    width: 100%;
  }

  .scenarios-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px 48px;
    background: #0E251B;
    color: #fff;
  }

  .scenarios-copy__eyebrow {
    margin: 0 0 24px;
    color: #d8bd77;
    font-family: var(--font-ppnue);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .scenarios-copy__rule {
    width: 56px;
    height: 2px;
    margin-bottom: 24px;
    background: #b08c3a;
  }

  .scenarios-copy h2 {
    margin: 0 0 20px;
    font-family: var(--font-ppnue);
    font-size: 42px;
    font-weight: 500;
    line-height: 1.15;
  }

  .scenarios-copy > p:last-child {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-ppnue);
    font-size: 16px;
    line-height: 1.75;
  }

  .scenarios-copy__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    align-self: flex-start;
    margin-top: 30px;
    padding: 12px 15px;
    border: 1px solid rgba(255, 255, 255, 0.48);
    color: #fff;
    font-family: var(--font-ppnue);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .scenarios-copy__link:hover {
    border-color: #b08c3a;
    background: #b08c3a;
  }

  .scenarios-copy__link svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .scenarios-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    min-width: 0;
  }

  .scenarios-grid__item {
    position: relative;
    min-height: 390px;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #253020;
  }

  .scenarios-grid__item::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 35%, rgba(0, 0, 0, 0.72) 100%);
    content: "";
  }

  .scenarios-grid__item img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .scenarios-grid__item:hover img {
    transform: scale(1.04);
  }

  .scenarios-grid__item figcaption {
    position: absolute;
    z-index: 1;
    right: 14px;
    bottom: 18px;
    left: 14px;
    color: #fff;
    font-family: var(--font-ppnue);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .scenarios-section__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .scenarios-copy {
      padding: 44px 32px;
    }

    .scenarios-grid__item {
      min-height: 320px;
    }
  }

  @media (max-width: 600px) {
    .scenarios-copy {
      padding: 36px 24px;
    }

    .scenarios-copy h2 {
      font-size: 34px;
    }

    .scenarios-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .scenarios-grid__item {
      min-height: 250px;
    }

    .scenarios-grid__item figcaption { font-size: 11px; }
  }

  .inc-cta {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .inc-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: 0;
  }

  .inc-cta__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.634);
  }

  .inc-cta__inner {
    position: relative;
    height: 400px;
    width: 100%;
    margin: 0 auto;
  }
</style>


</BaseLayout>

<style is:global>

:root {
  --color-verde:       #2d5a27;
  --color-verdec:      #3a7a32;
  --color-verde-claro: #4a9a3f;
  --color-verde-subtle: rgba(45, 90, 39, 0.12);
  --color-verde-border: rgba(45, 90, 39, 0.16);
  --color-red:         #B8231E;
  --color-red-dark:    #8f1a16;
  --color-dark:        #1a1a1a;
  --color-darker:      #0a0c0a;
  --color-navy:        #1c1e2a;
  --color-cream:       #ffffff;
  --color-off-white:   #faf9f8;
  --color-text-muted:  rgba(255, 255, 255, 0.65);
  --color-ink:         #181c17;
  --color-muted:       #6b7068;

  --font-display: 'Cormorant Garamond', Georgia, serif;
  --font-body:    'DM Sans', system-ui, sans-serif;

  --nav-height:   72px;
  --section-px:   8%;

  /* Bordes */
  --radius-sm: 2px;
  --radius-md: 4px;
  --radius-lg: 8px;

  /* Transiciones */
  --transition-fast: 0.22s ease;
  --transition-mid:  0.35s ease;
}

/* ── RESET ── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 18px;
}

body {
  font-family: var(--font-ppnue);
  background: var(--color-darker);
  color: #fff;
  overflow-x: hidden;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img, video { display: block; max-width: 100%; }
a { text-decoration: none; }
button { cursor: pointer; }

/* ── SCROLLBAR ── */
