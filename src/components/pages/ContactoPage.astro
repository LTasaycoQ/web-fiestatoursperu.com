</style>

<script>
  (function() {
    function showToast(message: string) {
      const toast = document.getElementById('toast') as HTMLElement;
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }

    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const destino = (document.getElementById('destino') as HTMLSelectElement)?.value;
        const cuando = (document.querySelector('input[name="cuando"]:checked') as HTMLInputElement)?.value;
        const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement)?.value;
        const titulo = (document.getElementById('titulo') as HTMLSelectElement)?.value;
        const nombre = (document.getElementById('nombre') as HTMLInputElement)?.value;
        const apellido = (document.getElementById('apellido') as HTMLInputElement)?.value;
        const email = (document.getElementById('email') as HTMLInputElement)?.value;
        const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value;
        const consentimiento = (document.getElementById('consentimiento') as HTMLInputElement)?.checked;
        
        if (!destino || !cuando || !mensaje) {
          showToast('Por favor, completa tu información de viaje');
          return;
        }
        
        if (!titulo || !nombre || !apellido || !email || !telefono) {
          showToast('Por favor, completa todos tus datos personales');
          return;
        }
        
        if (!consentimiento) {
          showToast('Debes aceptar los términos y condiciones para continuar');
          return;
        }
        
        if (!email.includes('@')) {
          showToast('Por favor, ingresa un email válido');
          return;
        }
        
        const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
        const originalText = submitBtn?.innerHTML;
        
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="btn-text">Enviando...</span>';
        }
        
        setTimeout(() => {
          showToast('¡Mensaje enviado con éxito! Te contactaremos pronto.');
          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText || '';
          }
        }, 1500);
      });
    }
  })();
</script>