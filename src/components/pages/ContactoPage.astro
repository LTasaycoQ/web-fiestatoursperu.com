---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@i18n/index';
import type { Locale } from '@i18n/index';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contacto;
---

<BaseLayout title={c.metaTitle} description={c.metaDesc}>
  <section class="contact-hero">
    <div class="contact-hero__bg">
      <img
        src="https://res.cloudinary.com/dlgeap8h0/image/upload/v1789775761/610a5497-f224-4955-8a1f-75bd86499c24_ke2nkj.jpg"
        alt="Asesor de viajes de Fiesta Tours Perú atendiendo clientes"
        fetchpriority="high"
      />
    </div>
    <div class="contact-hero__overlay"></div>
    
    <div class="contact-hero__content" data-aos="fade-up">
      <span class="hero-eyebrow titulo_pp_nuel">{c.eyebrow}</span>
      <h1 class="contact-hero__title titulo_font_abril">Empieza a planificar </br> tu viaje</h1>
      <div style="display:flex; justity-content:start; align-items:start;">
      <div class="hero-rule"></div>
      </div>
      <div style="display:flex; align-items:start; justify-content: start;">
      <p class="contact-hero__subtitle titulo_pp_nuel">Estamos aquí para ayudarte a crear el viaje de tus sueños</p>
        </div>
    </div>

    <div class="contact-hero__scroll" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="scroll-label">Contactar</span>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-container" data-aos="fade-up">
      

      <div class="contact-grid">
        <div class="contact-form-container">
          <form class="contact-form" id="contact-form" novalidate>

            <div class="form-card">

              
            <div style="display:flex; align-items:center;">
                <div style="background-color: #C8A96A; width: 34px; height: 1.8px; " />
                  <span style="padding-left: 15px;font-family:var(--font-ppnue); letter-spacing: 5px; font-size: 14px; font-weight: 600; text-transform: uppercase; color: #C8A96A;">Consulta</span>
            </div>
              <div class="form-section-header">
                <h3 class="form-section-title">Cuéntanos sobre el Viaje que Imaginas.</h3>
              </div>

              <div class="privacy-notice">
                
                <p>
                  Cuanto más conozcamos sobre tus planes desde el inicio, mejor podremos crear una propuesta diseñada especialmente para ti. Cada solicitud es revisada personalmente por uno de nuestros asesores de viajes.
                </p>
              </div>

              <div class="form-row form-row--three">
                <!-- <div class="form-group">
                  <label for="titulo">Título *</label>
                  <div class="input-wrapper select-wrapper">
                    <select id="titulo" name="titulo" required>
                      <option value="" disabled selected>Seleccionar</option>
                      <option value="Sr.">Sr.</option>
                      <option value="Sra.">Sra.</option>
                      <option value="Srta.">Srta.</option>
                      <option value="Dr.">Dr.</option>
                      <option value="Dra.">Dra.</option>
                    </select>
                    <span class="input-border"></span>
                  </div>
                </div> -->
                <div class="form-group">
                  <label for="nombre">{c.labelName} *</label>
                  <div class="input-wrapper">
                    <input id="nombre" type="text" name="nombre" required />
                    <span class="input-border"></span>
                  </div>
                </div>
                <div class="form-group">
                  <label for="apellido">Apellido *</label>
                  <div class="input-wrapper">
                    <input id="apellido" type="text" name="apellido"  required />
                    <span class="input-border"></span>
                  </div>
                </div>
              </div>

              <div class="form-row form-row--three">
              <!-- Email -->
                <div class="form-group">
                  <label for="email">{c.labelEmail} *</label>
                  <div class="input-wrapper">
                    <input id="email" type="email" name="email" required />
                    <span class="input-border"></span>
                  </div>
                </div>

                <!-- Teléfono -->
                <div class="form-group">
                  <label for="telefono">Teléfono *</label>
                  <div class="input-wrapper phone-wrapper">
                    <input style="padding: 12px 20px;" id="telefono" type="tel" name="telefono"required />
                    <span class="input-border"></span>
                  </div>
                </div>
               </div>

               <div class="form-group">
                  <label for="telefono">¿Que tipo de experiencia estas buscando?</label>
                  <div class=" phone-wrapper">
                    <select class="input-wrapper_select" name="" id="">
                    <option value="">Vacaciones a medida</option>
                    <option value="">Crucero en el Amazonas</option>
                    <option value="">Alojamientos</option>
                    <option value="">Luna de miel / Aniversario</option>
                    <option value="">Familiar / Multigeneracional</option>
                    <option value="">Viajes corporativos</option>
                    <option value="">Otros</option>
                  </select>
                  </div>
                  

                </div>

                 <div class="form-row form-row--three">
                <div class="form-group">
                  <label for="text">Fecha aproximada del viaje</label>
                  <div class="input-wrapper">
                    <input id="email" type="text" name="textdate" placeholder="Ej.: Octubre de 2027" required />
                    <span class="input-border"></span>
                  </div>
                </div>


                  <div class="form-group">
                  <label for="text">Viajeros</label>
                  <div class="input-wrapper">
                    <input id="email" type="text" name="textdate" placeholder="Ej.: 2 adultos, 2 niños" required />
                    <span class="input-border"></span>
                  </div>
                </div>
               </div>


               <div class="form-group">
                <label for="telefono">Cuentanos un poco sobre el viaje que tienes en mente</label>
                <div class="input-wrapper phone-wrapper">
                  <textarea id="telefono" name="mensaje" required />
                </div>
              </div>


              <!-- <div class="form-group checkbox-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="consentimiento" name="consentimiento" required />
                  <span class="checkmark"></span>
                  <span class="checkbox-text">
                    Solicitamos tu número para que uno de nuestros especialistas pueda llamarte o enviarte un mensaje de texto para hablar sobre tus planes de viaje. Aplican tarifas estándar. El consentimiento no es una condición de compra. La frecuencia de mensajes varía. Responde STOP para darte de baja. Responde HELP para obtener ayuda. <a href="/politica-privacidad" target="_blank">Política de Privacidad</a> y <a href="/terminos" target="_blank">Términos y Condiciones</a>. Al hacer clic en "Enviar consulta" y enviar este formulario, aceptas recibir mensajes de texto de Fiesta Tours.
                  </span>
                </label>
              </div>

              <div class="form-group video-appointment">
                <div class="video-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="6" width="13" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M15 10L22 6V18L15 14V10Z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <label class="checkbox-label video-label">
                  <input type="checkbox" id="video" name="video" />
                  <span class="checkmark"></span>
                  <span class="checkbox-text">
                    Agendar una videollamada. Habla con un especialista sobre tus planes de viaje en una videollamada, sin necesidad de descargar software y en el horario que te convenga.
                  </span>
                </label>
              </div> -->
              
              <div class="submit-wrapper">
              <button type="submit" class="submit-btn">
                <span class="btn-text">{c.submitBtn}</span>
                <span class="btn-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </span>
              </button>
            </div>
            </div>

            

          </form>
        </div>

            <div class="info-card" style="background-color: white; border-radius: 30px;">
            <div class="info-header">
              <h3 class="info-title" style="font-size: 27px; ">{c.infoTitle}</h3>
              <div class="info-decoration"></div>
            </div>
            
            <div class="info-details">
              <div class="info-item">
                <div class="info-icon-wrapper" style="background-color: rgb(65, 83, 65);">
                  <svg class="info-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <div class="info-content">
                  <span class="info-label">Dirección</span>
                  <span class="info-text">Av San Luis 2642, San Borja, 15037, Lima, Peru</span>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon-wrapper" style="background-color: rgb(65, 83, 65);">
                  <svg class="info-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <div class="info-content">
                  <span class="info-label">Teléfono</span>
                  <span class="info-text">{c.phone}</span>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon-wrapper" style="background-color: rgb(65, 83, 65);">
                  <svg class="info-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5"/>
                    <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <div class="info-content" >
                  <span class="info-label">Email</span>
                  <span class="info-text">{c.email}</span>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon-wrapper" style="background-color: rgb(65, 83, 65);">
                  <svg class="info-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                    <polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </div>
                <div class="info-content">
                  <span class="info-label">Horario</span>
                  <span class="info-text">{c.hours}</span>
                </div>
              </div>
            </div>

           
            <div class="social-links">
              <span class="social-label">Síguenos</span>
              <div class="social-icons">
                <a href="https://www.instagram.com/fiestatoursperu/" target="_blank" class="social-icon" aria-label="Instagram">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>
                  </svg>
                </a>
                <a href="https://www.facebook.com/fiestatoursinternational/?locale=es_LA" target="_blank" class="social-icon" aria-label="Facebook">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </a>
                <a href="https://www.linkedin.com/company/fiestatoursperu/posts/?feedView=all" target="_blank" class="social-icon" aria-label="Twitter">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-linkedin" viewBox="0 0 16 16">
                    <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
        </div>
      </div>
      </div>

      
    </div>
  </section>

  <!-- Toast Notificación -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</BaseLayout>

<style>
/* ═══════════════════════════════════════════════════════════════ */
/* VARIABLES                                                       */
/* ═══════════════════════════════════════════════════════════════ */
:root {
  --verde:       #3e4b3c;
  --verdec:      #478a3d;
  --verde-claro: #5a9a50;
  --verde-light: rgba(62, 75, 60, 0.08);
  --verde-border: rgba(62, 75, 60, 0.12);
  --ink:         #1a1a1a;
  --ink-mid:     #2d2d2d;
  --ink-soft:    #6b6b6b;
  --cream:       #ffffff;
  --rule:        rgba(0, 0, 0, 0.08);
  --ff-display: 'Cormorant Garamond', Georgia, serif;
  --ff-body:    'DM Sans', system-ui, sans-serif;
  --ease:       cubic-bezier(0.22, 1, 0.36, 1);
}

/* ═══════════════════════════════════════════════════════════════ */
/* HERO                                                            */
/* ═══════════════════════════════════════════════════════════════ */
.contact-hero {
  position: relative;
  height: 75vh;
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--verde);
  margin-top: -72px;
  padding-top: 72px;
}

@media (max-width: 768px) {
  .contact-hero { min-height: 480px; }
}

.contact-hero__bg { position: absolute; inset: 0; z-index: 0; }

.contact-hero__bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  transition: transform 12s var(--ease);
  transform: scale(1.04);
}

.contact-hero:hover .contact-hero__bg img { transform: scale(1); }

.contact-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(to right, rgba(10, 12, 10, 0.846) 0%, rgba(10, 12, 10, 0.619) 52%, rgba(10, 12, 10, 0.461) 100%),
    linear-gradient(to top, rgba(10,12,10,0.7) 0%, transparent 50%),
    linear-gradient(135deg, rgba(62, 75, 60, 0.475) 0%, transparent 55%);
}

.contact-hero__content {
  position: relative;
  z-index: 3;
  display:flex;
  flex-direction: column;
  justify-content: start;
  align-items: start;
  text-align: start;
  width: 100%;
  padding: 0 6%;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
  padding: 8px 24px;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  border-radius: 40px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.85);
}

.hero-eyebrow::before {
  content: "";
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--verdec);
  animation: heroDotPulse 2.4s ease-in-out infinite;
}

@keyframes heroDotPulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(71,138,61,0.5); }
  50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(71,138,61,0); }
}

.contact-hero__title {
  font-size: clamp(42px, 6vw, 70px);
  color: #fff;
  font-weight: 100;
  line-height: 1.1;
  letter-spacing: 0.00001em;
}

.hero-rule {
  width: 56px;
  height: 2px;
  background: linear-gradient(to right, var(--verdec), rgba(71,138,61,0.3));
  margin: 0 auto 24px;
}

.contact-hero__subtitle {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.7);
  margin: 0 auto;
  font-weight: 300;
}

.contact-hero__scroll {
  position: absolute;
  bottom: 36px;
  right: 6%;
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

@media (max-width: 768px) { .contact-hero__scroll { display: none; } }

.scroll-line {
  display: block;
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.18), transparent);
  animation: scrollLineAnim 2s ease-in-out infinite;
}

@keyframes scrollLineAnim {
  0% { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

.scroll-label {
  font-size: 9px;
  letter-spacing: 0.26em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.28);
  writing-mode: vertical-rl;
  font-weight: 500;
}

/* ═══════════════════════════════════════════════════════════════ */
/* CONTACT SECTION                                                 */
/* ═══════════════════════════════════════════════════════════════ */
.contact-section {
  background: #FFFFFF;
  padding: 80px 6%;
  position: relative;
}

.contact-container { max-width: 1400px; margin: 0 auto; }

.contact-section__header {
  text-align: center;
  margin-bottom: 60px;
}

.section-eyebrow {
  display: inline-block;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--verdec);
  margin-bottom: 16px;
}

.contact-section__title {
  font-size: clamp(36px, 4.5vw, 52px);
  margin-bottom: 20px;
  font-weight: 100;
  color: var(--ink);
  letter-spacing: -0.02em;
}

.verde-rule {
  width: 48px;
  height: 2px;
  background: var(--verdec);
  margin: 0 auto 20px;
}

.contact-section__description {
  max-width: 650px;
  margin: 0 auto;
  color: var(--ink-soft);
  font-size: 16px;
  line-height: 1.7;
  font-weight: 400;
}

/* ═══════════════════════════════════════════════════════════════ */
/* GRID                                                            */
/* ═══════════════════════════════════════════════════════════════ */
.contact-grid {
  display: flex;
  gap: 10px;
  margin-bottom: 80px;
}
.contact-form-container { 
  width: 90%;
  position: relative; }


.info-card {
  background: #324632;
  padding: 42px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
  height: 100%;
  margin-top: 80px;
  width: 50%;
  transition: all 0.4s var(--ease);
  border: 1px solid var(--verde-border);
  position: sticky;
  top: 100px;
}

@media (max-width: 1100px) {
  
  
.info-card {
  width: 100%;  
   margin-top: 0px;
}
  .contact-grid {
    display: flex;
    flex-direction: column;

  }
  .contact-form-container { 
    width: 100%;
  }
}

@media (max-width: 968px) {
  .contact-grid { grid-template-columns: 1fr; gap: 48px; }
}



.contact-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.form-card {
  background: #ffffff00;
  padding: 36px 42px;
  transition: all 0.4s var(--ease);
}

.form-card:hover {
  border-color: rgba(62, 75, 60, 0.2);
}

@media (max-width: 768px) { .form-card { padding: 28px 24px; } }

.form-section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10px;
}

.form-section-title {
  font-size: 36px;
  line-height: 60px;
  font-family: var(--font-ppnue);
  font-weight: 300;
  font-style: normal;
  color: rgb(17, 17, 17);
  margin: 0;
}

.required-note {
  font-size: 11px;
  color: var(--ink-soft);
  font-style: italic;
}

.privacy-notice {
  font-family: var(--font-ppnue);
  display: flex;
  gap: 12px;
  border-radius: 10px;
  margin-bottom: 38px;
  align-items: center;
}

.privacy-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  color: var(--ink);
  margin-top: 1px;
}

.privacy-notice p {
  margin: 0;
  font-size: 15px;
  letter-spacing: -0.20px;
  line-height: 1.6;
  color: black;
}

.privacy-notice a {
  color: var(--verdec);
  text-decoration: underline;
  text-underline-offset: 2px;
}
/* Options row (tarjetas de opciones) */
.options-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  padding: 16px;
  background: #f4f6f4;
  border-radius: 10px;
}

@media (max-width: 640px) {
  .options-row {
    grid-template-columns: 1fr;
    gap: 10px;
  }
}

.option-card {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  padding: 6px 4px;
  transition: all 0.2s;
}

.option-card input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.option-box {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  border: 1.5px solid #aaa;
  border-radius: 4px;
  background: #fff;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-card input:checked + .option-box {
  background: var(--verdec);
  border-color: var(--verdec);
}

