---
import { localePath } from "@i18n";
import { footerSections, footerLegal } from "@lib/footer";
import ApavitLogo from "@assets/logos-Respaldo/apavit.png";
import ApturLogo from "@assets/logos-Respaldo/Aptur.png";
import SiteLogo from "@assets/logos-Respaldo/SITE.png";
import TurismoCuscoLogo from "@assets/logos-Respaldo/tuRISMO-cUSCO.png";
import UstoaLogo from "@assets/logos-Respaldo/ustoa_white.png";

import logo_extra_certificacion from "@assets/certification/certificate.png";
import prtect from "@assets/certification/PROTECT.png";

const { lang, t } = Astro.props;
import { Image } from "astro:assets";
import LogoEs from "../../assets/log-png.png";
---

<footer class="luxury-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-col-brand">
        <div class="footer-brand">
          <a href={localePath(lang, "/")} class="footer-logo">
            <Image
              src={LogoEs}
              alt="Fiesta Tours Perú"
              class="footer-logo-img"
              loading="eager"
              decoding="async"
            />
          </a>
          <p class="footer-description">50 años creando experiencias de viajes inolvidables</p>

          <div class="footer-contact">
            <span class="footer-contact__item">
              <svg class="footer-contact__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Av San Luis 2642, San Borja, 15037, Lima, Peru</span>
            </span>

            <a href="tel:+51982836947" class="footer-contact__item">
              <svg class="footer-contact__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>(+51) 982 836 947</span>
            </a>

            <a href="mailto:info@fiestatoursperu.com" class="footer-contact__item">
              <svg class="footer-contact__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path>
                <path d="M3 7l9 6l9-6"></path>
              </svg>
              <span>info@fiestatoursperu.com</span>
            </a>
          </div>
        </div>

        <div class="logo_extras">
          <img src={prtect.src} alt="Certificación" />
          <img src={logo_extra_certificacion.src} alt="Certificación" />
        </div>
      </div>

      <div class="footer-col-right">
        <div class="footer-links-newsletter">
          {
            footerSections.map((section) => (
              <div class="footer-links">
                <h4>{t.footer[section.titleKey as keyof typeof t.footer]}</h4>
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a href={localePath(lang, link.path)}>
                        {t.footer[link.key as keyof typeof t.footer]}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }

          <div class="footer-newsletter">
            <h4>Inspírate</h4>
            <p>Suscríbete para recibir ofertas exclusivas y novedades.</p>
            <form class="newsletter-form" action="/subscribe" method="POST">
              <input
                type="email"
                placeholder="Tu correo electrónico"
                aria-label="Correo para newsletter"
                required
              />
              <button type="submit" aria-label="Suscribirse">→</button>
            </form>

            <div class="social-links">
              <a href="https://www.facebook.com/fiestatoursinternational/?locale=es_LA" target="_blank" rel="noopener" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              </a>

              <a href="https://www.instagram.com/fiestatoursperu/" target="_blank" rel="noopener" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>

              <a href="https://www.linkedin.com/company/fiestatoursperu/posts/?feedView=all" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.063 2.063 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="logos_socios__grid" data-aos="fade-up" data-aos-duration="1000">
          <div class="partner-logo">
            <img src={UstoaLogo.src} alt="USTOA" loading="lazy" />
          </div>
          <div class="partner-logo">
            <img src={SiteLogo.src} alt="SITE" loading="lazy" />
          </div>
          <div class="partner-logo">
            <img src={ApavitLogo.src} alt="APAVIT" loading="lazy" />
          </div>
          <div class="partner-logo">
            <img src={ApturLogo.src} alt="APTUR" loading="lazy" />
          </div>
          <div class="partner-logo">
            <img src={TurismoCuscoLogo.src} alt="Turismo Cusco" loading="lazy" />
          </div>
        </div>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Fiesta Tours Perú. Todos los derechos reservados.</p>
      <div class="footer-bottom-links">
        {
          footerLegal.map((link) => (
            <a href={localePath(lang, link.path)}>
              {t.footer[link.key as keyof typeof t.footer]}
            </a>
          ))
        }
      </div>
      <div class="payment-methods">
        <span>Pago seguro con:</span>
        <span>Visa</span>
        <span>Mastercard</span>
        <span>Amex</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .luxury-footer {
    background: #000000;
    color: #b0b0b0;
    padding: 64px 5% 32px;
    font-family: var(--font-body, "DM Sans", sans-serif);
    margin-top: auto;
  }

  .footer-container {
    max-width: 1600px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.65fr) 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  /* ─── Columna izquierda ─── */
  .footer-col-brand {
    display: flex;
    flex-direction: column;
    gap: 28px;
    width: 100%;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-logo {
    display: inline-block;
    text-decoration: none;
  }

  .footer-logo-img {
    width: 190px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .footer-logo-img:hover {
    opacity: 1;
  }

  .footer-description {
    font-size: 13px;
    line-height: 1.6;
    color: #b0b0b0;
    max-width: 320px;
    margin: 0;
  }

  /* ─── Contacto ─── */
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
  }

  .footer-contact__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #b0b0b0;
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.4;
  }

  .footer-contact__item:hover {
    color: #f8f9f5;
  }

  .footer-contact__icon {
    flex-shrink: 0;
    color: #fbfbfb;
    opacity: 0.9;
    margin-top: 2px;
  }

  /* ─── Certificaciones (Protect + Certificate) ─── */
  .logo_extras {
    display: flex;
    gap: 40px;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .logo_extras img:first-child {
    width: 70px;
    height: auto;
  }

  .logo_extras img:last-child {
    width: 160px;
    height: auto;
  }

  /* ─── Columna derecha ─── */
  .footer-col-right {
    display: flex;
    flex-direction: column;
    gap: 48px;
    width: 100%;
  }

  .footer-links-newsletter {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 48px;
    width: 100%;
  }

  /* ─── Links ─── */
  .footer-links h4 {
    color: white;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: 12px;
  }

  .footer-links a {
    color: #b0b0b0;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-verdec, #478a3d);
  }

  /* ─── Newsletter ─── */
  .footer-newsletter h4 {
    color: white;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .footer-newsletter p {
    font-size: 13px;
    line-height: 1.5;
    color: #b0b0b0;
    margin: 0 0 20px;
  }

  .newsletter-form {
    display: flex;
    margin-bottom: 24px;
    max-width: 340px;
  }

  .newsletter-form input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    border: none;
    background: #333;
    color: white;
    border-radius: 30px 0 0 30px;
    outline: none;
    font-size: 13px;
    font-family: inherit;
  }

  .newsletter-form input::placeholder {
    color: #888;
  }

  .newsletter-form input:focus {
    background: #3a3a3a;
  }

  .newsletter-form button {
    background: var(--color-verdec, #478a3d);
    border: none;
    padding: 0 20px;
    border-radius: 0 30px 30px 0;
    color: white;
    cursor: pointer;
    font-weight: bold;
    font-size: 18px;
    transition: background 0.2s ease;
  }

  .newsletter-form button:hover {
    background: #2d5a25;
  }

  /* ─── Redes sociales ─── */
  .social-links {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .social-links a:hover {
    background: var(--color-verdec, #478a3d);
    color: #fff;
    transform: translateY(-3px);
  }

  .social-links svg {
    display: block;
  }

  .logos_socios__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    justify-items: center;
    gap: 24px;
    width: 100%;
    margin: 0;
    padding: 24px 0;
    position: static;
    left: auto;
    border-top: 1px solid #222;
  }

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 60px;
    width: 100%;
  }

  .partner-logo img {
    max-width: 100%;
    height: auto;
    max-height: 120px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .partner-logo img:hover {
    opacity: 0.85;
    transform: scale(1.05);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 32px;
    border-top: 1px solid #333;
    font-size: 12px;
  }

  .footer-bottom p {
    margin: 0;
    color: #888;
  }

  .footer-bottom-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    color: #888;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-bottom-links a:hover {
    color: var(--color-verdec, #478a3d);
  }

  .payment-methods {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .payment-methods span:first-child {
    color: #888;
    font-size: 11px;
  }

  .payment-methods span:not(:first-child) {
    background: #333;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11px;
    color: #ccc;
    letter-spacing: 0.5px;
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — TABLET (≤ 1024px)
     ═══════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .footer-col-brand {
      align-items: flex-start;
    }

    .footer-links-newsletter {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .logos_socios__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — MÓVIL (≤ 768px)
     ═══════════════════════════════════════════ */
  @media (max-width: 768px) {
    .luxury-footer {
      padding: 48px 5% 24px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 32px;
    }

    .footer-description {
      max-width: 100%;
    }

    .logo_extras {
      gap: 24px;
    }

    .logo_extras img:first-child {
      width: 60px;
    }

    .logo_extras img:last-child {
      width: 130px;
    }

    .footer-links-newsletter {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }

    .newsletter-form {
      max-width: 100%;
    }

    .logos_socios__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      padding: 20px 0;
    }

    .partner-logo {
      min-height: 50px;
    }

    .partner-logo img {
      max-height: 90px;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }

    .footer-bottom-links {
      justify-content: center;
    }

    .payment-methods {
      justify-content: center;
    }
  }

  /* ═══════════════════════════════════════════
     RESPONSIVE — MÓVIL PEQUEÑO (≤ 480px)
     ═══════════════════════════════════════════ */
  @media (max-width: 480px) {
    .luxury-footer {
      padding: 40px 4% 20px;
    }

    .footer-logo-img {
      width: 150px;
    }

    .footer-links-newsletter {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .logo_extras {
      gap: 20px;
    }

    .logo_extras img:first-child {
      width: 55px;
    }

    .logo_extras img:last-child {
      width: 120px;
    }

    .logos_socios__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .partner-logo {
      min-height: 44px;
    }

    .partner-logo img {
      max-height: 94px;
    }

    .newsletter-form input {
      padding: 10px 14px;
      font-size: 12px;
    }

    .newsletter-form button {
      padding: 0 16px;
      font-size: 16px;
    }

    .social-links {
      justify-content: flex-start;
    }

    .social-links a {
      width: 34px;
      height: 34px;
    }

    .footer-bottom-links {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .payment-methods {
      gap: 8px;
    }
  }

  /* ═══════════════════════════════════════════
     FIX iPad (768px – 1024px)
     ═══════════════════════════════════════════ */
  @media (min-width: 768px) and (max-width: 1024px) {
    .footer-logo-img {
      width: 170px;
      -webkit-transform: translateZ(0);
      transform: translateZ(0);
    }

    .logos_socios__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>