---
// Maps.astro
interface Waypoint {
  id: string;
  name: string;
  lat: number;
  lng: number;
  zoom: number;
  color: string;
  image?: string;
  desc?: string;
}

interface Props {
  waypoints?: Waypoint[];
}

const { waypoints = [] } = Astro.props;
const waypointsJSON = JSON.stringify(waypoints);
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  crossorigin=""
/>

<div class="map-container">
  <div id="leaflet-map" data-waypoints={waypointsJSON}></div>
</div>

<style>
  .map-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #leaflet-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .leaflet-tile {
    filter: sepia(25%) saturate(0.85) brightness(1.04);
  }

  .leaflet-div-icon {
    background: none !important;
    border: none !important;
  }

  .custom-popup .leaflet-popup-content-wrapper {
    padding: 0;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(200, 150, 42, 0.2);
  }
  .custom-popup .leaflet-popup-content {
    margin: 0;
    width: 240px !important;
  }
  .custom-popup .leaflet-popup-tip-container {
    margin-top: -1px;
  }
  .custom-popup .leaflet-popup-tip {
    background: white;
    box-shadow: none;
  }
  .map-popup__img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }
  .map-popup__body {
    padding: 10px 14px 13px;
  }
  .map-popup__body h4 {
    margin: 0 0 3px;
    font-size: 13px;
    font-weight: 700;
    color: #1a1208;
    letter-spacing: 0.03em;
    font-family: "Cormorant Garamond", serif;
  }
  .map-popup__body p {
    margin: 0;
    font-size: 11px;
    color: #888;
    line-height: 1.5;
  }

  .map-legend {
    position: absolute;
    bottom: 20px;
    left: 16px;
    z-index: 1000;
    background: rgba(255, 252, 247, 0.94);
    backdrop-filter: blur(8px);
    border-radius: 8px;
    padding: 12px 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(200, 150, 42, 0.2);
    min-width: 170px;
    pointer-events: none;
  }
  .legend-title {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c8962a;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(200, 150, 42, 0.2);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 7px;
    opacity: 0.4;
    transition: opacity 0.4s ease;
  }
  .legend-item.active { opacity: 1; }
  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }
  .legend-label {
    font-size: 11px;
    font-weight: 600;
    color: #1a1208;
    letter-spacing: 0.04em;
  }

  .leaflet-control-zoom {
    border: none !important;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1) !important;
  }
  .leaflet-control-zoom a {
    background: rgba(255, 252, 247, 0.95) !important;
    color: #1a1208 !important;
    border: 1px solid rgba(200, 150, 42, 0.2) !important;
    font-weight: 700 !important;
  }
  .leaflet-control-zoom a:hover {
    background: #c8962a !important;
    color: white !important;
  }
  .leaflet-control-attribution {
    font-size: 9px !important;
    background: rgba(255, 255, 255, 0.7) !important;
  }
</style>

<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  crossorigin=""
  is:inline
></script>

<script is:inline>
(function () {

  var MAP_INSTANCE_KEY = '__leafletMapInstance__';

  function createMarkerIcon(color, isActive) {
    var size = isActive ? 28 : 20;
    var svg =
      '<svg xmlns="http://www.w3.org/2000/svg" width="' + size + '" height="' + size + '" viewBox="0 0 16 16" fill="' + color + '" style="filter:drop-shadow(0 3px 5px rgba(0,0,0,.4));display:block;">' +
      (isActive ? '<animateTransform attributeName="transform" type="scale" values="1;1.15;1" dur="1.2s" repeatCount="indefinite"/>' : '') +
      '<path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>' +
      '</svg>';

    return window.L.divIcon({
      html: svg,
      className: '',
      iconSize: [size, size],
      iconAnchor: [size / 2, size],
      popupAnchor: [0, -(size + 4)],
    });
  }

  function buildPopupHTML(wp) {
    var html = '<div class="map-popup">';
    if (wp.image) html += '<img class="map-popup__img" src="' + wp.image + '" alt="' + wp.name + '" />';
    html += '<div class="map-popup__body"><h4>' + wp.name + '</h4>';
    if (wp.desc) html += '<p>' + wp.desc + '</p>';
    html += '</div></div>';
    return html;
  }

  function destroyMap(el) {
    if (el && el[MAP_INSTANCE_KEY]) {
      try {
        el[MAP_INSTANCE_KEY].remove();
      } catch (e) {}
      el[MAP_INSTANCE_KEY] = null;
    }
    if (el) {
      delete el._leaflet_id;
    }
  }

  function buildMap() {
    var L = window.L;
    if (!L) return false;

    var el = document.getElementById('leaflet-map');
    if (!el) return false;

    var wrapper = el.closest('.itinerary-map-wrap') || el.parentElement;
    var h = wrapper
      ? wrapper.getBoundingClientRect().height
      : el.getBoundingClientRect().height;
    if (h < 10) return false;

    destroyMap(el);

    delete L.Icon.Default.prototype._getIconUrl;
    L.Icon.Default.mergeOptions({
      iconUrl: 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7',
      shadowUrl: '',
      iconSize: [0, 0],
      shadowSize: [0, 0],
    });

    var waypoints = [];
    try {
      waypoints = JSON.parse(el.getAttribute('data-waypoints') || '[]');
    } catch (e) {}

    if (!waypoints.length) {
      waypoints = [
        { id: 'cusco',         name: 'Cusco',         lat: -13.5319, lng: -71.9675, zoom: 9,  color: '#c8962a' },
        { id: 'machu-picchu',  name: 'Machu Picchu',  lat: -13.1631, lng: -72.5450, zoom: 12, color: '#8B6914' },
        { id: 'valle-sagrado', name: 'Valle Sagrado',  lat: -13.3167, lng: -72.0833, zoom: 11, color: '#5a8a3c' },
        { id: 'ollantaytambo', name: 'Ollantaytambo', lat: -13.2588, lng: -72.2638, zoom: 13, color: '#8B3A3A' },
      ];
    }

    var map = L.map('leaflet-map', {
      center: [waypoints[0].lat, waypoints[0].lng],
      zoom: 9,
      zoomControl: true,
      scrollWheelZoom: false,
    });

    el[MAP_INSTANCE_KEY] = map;

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    map.invalidateSize();
    setTimeout(function () { map.invalidateSize(); }, 300);

    var markerMap = {};

    waypoints.forEach(function (wp) {
      var marker = L.marker([wp.lat, wp.lng], { icon: createMarkerIcon(wp.color, false) }).addTo(map);
      marker.bindTooltip(wp.name, { permanent: false, offset: [0, -8] });
      marker.bindPopup(buildPopupHTML(wp), { maxWidth: 240, className: 'custom-popup' });
      markerMap[wp.id] = marker;
    });

    L.polyline(waypoints.map(function (wp) { return [wp.lat, wp.lng]; }), {
      color: '#c8962a', weight: 2, opacity: 0.6, dashArray: '6,10',
    }).addTo(map);

    // ── Leyenda ──
    var legendEl = document.getElementById('legend-items');
    waypoints.forEach(function (wp) {
      var item = document.createElement('div');
      item.className = 'legend-item';
      item.id = 'legend-' + wp.id;
      item.innerHTML =
        '<div class="legend-dot" style="background:' + wp.color + '"></div>' +
        '<span class="legend-label">' + wp.name + '</span>';
      if (legendEl) legendEl.appendChild(item);
    });

    var currentActiveId = null;

    function flyToWaypoint(wpId) {
      var wp = waypoints.find(function (w) { return w.id === wpId; });
      if (!wp || currentActiveId === wpId) return;
      currentActiveId = wpId;
      waypoints.forEach(function (w) {
        if (markerMap[w.id]) markerMap[w.id].setIcon(createMarkerIcon(w.color, w.id === wpId));
      });
      document.querySelectorAll('.legend-item').forEach(function (e) { e.classList.remove('active'); });
      var leg = document.getElementById('legend-' + wpId);
      if (leg) leg.classList.add('active');
      map.flyTo([wp.lat, wp.lng], wp.zoom, { animate: true, duration: 1.4, easeLinearity: 0.35 });
    }

    // ── Mapeo nombre → id (normalizado, sin emojis ni espacios extra) ──
    var locationMapping = {};
    waypoints.forEach(function (wp) {
      // Normalizar: minúsculas y quitar caracteres no alfanuméricos salvo espacios
      var normalized = wp.name.toLowerCase().replace(/[^a-záéíóúüñ\s]/gi, '').trim();
      locationMapping[normalized] = wp.id;
    });

    // ── Función para extraer texto limpio del elemento location-pin ──
    function getLocationText(target) {
      // Intentar leer el span .location-pin__text que contiene "🏔 Cusco"
      var textEl = target.querySelector('.location-pin__text');
      var raw = textEl ? textEl.textContent : target.textContent || '';
      // Quitar emojis y caracteres especiales, dejar solo letras y espacios
      return raw.toLowerCase().replace(/[^a-záéíóúüñ\s]/gi, '').trim();
    }

    // ── IntersectionObserver sobre .js-location-label ──
    var ioObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var text = getLocationText(entry.target);
        // Buscar coincidencia en el mapeo
        for (var key in locationMapping) {
          if (text.indexOf(key) !== -1 || key.indexOf(text) !== -1) {
            flyToWaypoint(locationMapping[key]);
            break;
          }
        }
      });
    }, { rootMargin: '-10% 0px -50% 0px', threshold: 0 });

    setTimeout(function () {
      document.querySelectorAll('.js-location-label').forEach(function (labelEl) {
        ioObserver.observe(labelEl);
      });
    }, 400);

    // Activar el primer waypoint al cargar
    setTimeout(function () { flyToWaypoint(waypoints[0].id); }, 900);

    return true;
  }

  function waitAndBuild() {
    if (buildMap()) return;
    var wrapper = document.querySelector('.itinerary-map-wrap');
    if (wrapper && window.ResizeObserver) {
      var ro = new ResizeObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.contentRect.height > 10) { ro.disconnect(); buildMap(); }
        });
      });
      ro.observe(wrapper);
    } else {
      var tries = 0;
      var t = setInterval(function () { if (buildMap() || ++tries > 30) clearInterval(t); }, 150);
    }
  }

  document.addEventListener('astro:page-load', function () {
    setTimeout(waitAndBuild, 50);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitAndBuild);
  } else {
    waitAndBuild();
  }

})();
</script>