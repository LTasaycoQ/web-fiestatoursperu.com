---
import BlogDetailPage from '@components/pages/BlogDetailPage.astro';
import { locales, defaultLocale } from '@i18n/index';
import type { Locale } from '@i18n/index';
import { getAllBlogPosts } from 'src/data/posts';

export function getStaticPaths() {
  const posts = getAllBlogPosts();
  return locales
    .filter(l => l !== defaultLocale)
    .flatMap(lang =>
      posts.map(post => ({
        params: { lang, postId: post.slug },
      }))
    );
}

const { lang, postId } = Astro.params as { lang: Locale; postId: string };
---
<BlogDetailPage {lang} postId={postId} />