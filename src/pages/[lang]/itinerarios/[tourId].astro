---
import TourDetailPage from '@components/pages/TourDetailPage.astro';
import { locales, defaultLocale } from '@i18n/index';
import type { Locale } from '@i18n/index';
import { toursData } from 'src/data/tours';

export function getStaticPaths() {
  return locales
    .filter(l => l !== defaultLocale)
    .flatMap(lang =>
      toursData.map(tour => ({
        params: { lang, tourId: tour.id },
      }))
    );
}

const { lang, tourId } = Astro.params as { lang: Locale; tourId: string };
---
<TourDetailPage {lang} tourId={tourId} />