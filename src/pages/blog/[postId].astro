---
import BlogDetailPage from '@components/pages/BlogDetailPage.astro';
import { defaultLocale } from '@i18n/index';
import { getAllBlogPosts } from 'src/data/posts';

export function getStaticPaths() {
  return getAllBlogPosts().map(post => ({
    params: { postId: post.slug },
  }));
}

const { postId } = Astro.params;
---
<BlogDetailPage lang={defaultLocale} postId={postId!} />