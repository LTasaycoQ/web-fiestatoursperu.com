---
import Meta from "@components/seo/Meta.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import { getLang, useTranslations } from "@i18n/index";
import "@styles/global.css";
// IMPORTA EL CSS DIRECTAMENTE AQUÍ
import "aos/dist/aos.css"; 

interface Props {
  title?: string;
  description?: string;
  image?: string;
  fullscreen?: boolean;
}

const { title, description, image, fullscreen = false } = Astro.props;

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const pageTitle = title ?? t.meta.homeTitle;
const pageDescription = description ?? t.meta.homeDescription;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Meta title={pageTitle} description={pageDescription} {image} {lang} />

    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />


    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "wjf5g0m2dd");
    </script>

    <style>
      html { height: -webkit-fill-available; }
      body { min-height: 100vh; min-height: -webkit-fill-available; }
    </style>
  </head>
  <body>
    <Navbar {lang} {t} />

    <main class:list={[!fullscreen && "page-wrapper"]}>
      <slot />
    </main>

    <Footer {lang} {t} />
    <script>
      import AOS from 'aos';
      
      document.addEventListener('DOMContentLoaded', () => {
        AOS.init({
          duration: 800, 
          once: true
        });
      });
    </script>
  </body>
</html>
